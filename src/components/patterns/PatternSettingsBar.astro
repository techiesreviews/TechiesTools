---
import SettingsAccordion from "../settings/SettingsAccordion.astro";
import SettingsBar from "../settings/SettingsBar.astro";
import SettingsSegmentedControl from "../settings/SettingsSegmentedControl.astro";
import type { PatternDefinition } from "../../patterns/definition.ts";
import { compilePattern, selectedPatternOption } from "../../patterns/engine.ts";
import PatternExportDialog from "./PatternExportDialog.astro";

interface Props {
  definition: PatternDefinition;
}

const { definition } = Astro.props;
const compiled = compilePattern(definition);
const initialSelections = definition.controls.map((control) => {
  const selected = selectedPatternOption(definition, compiled.state, control.id);
  return control.options.find(({ id }) => id === selected)?.label ?? "Custom";
});
---

<SettingsBar path="Patterns" title={definition.title} ariaLabel={`${definition.title} pattern settings`}>
  <button slot="headerAction" type="button" data-pattern-reset data-settings-recovery>Reset</button>
  <Fragment slot="content">
    <div class="pattern-settings" data-pattern-settings data-settings-accordion-group>
      <SettingsAccordion id="appearance" title="Appearance" open summaryDataAttribute="data-pattern-summary">
        <Fragment slot="summary">{initialSelections.join(" · ")}</Fragment>
        {definition.controls.map((control) => (
          <SettingsSegmentedControl
            label={control.label}
            name={`pattern-control-${control.id}`}
            options={control.options.map(({ id, label }) => ({ label, value: id }))}
            value={selectedPatternOption(definition, compiled.state, control.id) ?? ""}
          />
        ))}
      </SettingsAccordion>

      <button class="pattern-advanced-open" type="button" aria-expanded="false" aria-controls="pattern-advanced-drawer" data-pattern-advanced-open>Advanced HTML &amp; CSS</button>
    </div>
  </Fragment>
  <PatternExportDialog slot="footer" definition={definition} />
</SettingsBar>

<style>
  .pattern-settings { display:grid; align-content:start; min-inline-size:0; }
  .pattern-advanced-open { min-block-size:38px; margin:10px 12px; border:1px solid var(--settings-bar-border); border-radius:var(--radius-m); background:var(--settings-bar-surface); color:var(--settings-bar-text); font:700 10px/1 inherit; cursor:pointer; }
  .pattern-advanced-open:hover { border-color:var(--settings-bar-accent); color:var(--settings-bar-accent); }
</style>
