---
import { X } from "@lucide/astro";
import PatternCssEditor from "./PatternCssEditor.astro";
import PatternHtmlEditor from "./PatternHtmlEditor.astro";

interface Props { title: string; html: string; css: string; }
const { title, html, css } = Astro.props;
---

<dialog class="pattern-advanced" aria-labelledby="pattern-advanced-title" data-pattern-advanced-drawer>
  <div class="pattern-advanced__surface">
    <header>
      <div><span>Advanced</span><h2 id="pattern-advanced-title">Edit {title}</h2></div>
      <button type="button" aria-label="Close advanced editor" data-pattern-advanced-close><X size={18} /></button>
    </header>
    <div class="pattern-advanced__editors">
      <section aria-label="HTML editor"><PatternHtmlEditor html={html} /></section>
      <section aria-label="CSS editor"><PatternCssEditor source={css} /></section>
    </div>
    <footer><p aria-live="polite" data-pattern-code-status>Valid edits apply to Preview and export automatically.</p></footer>
  </div>
</dialog>

<style>
  .pattern-advanced { inset:auto 0 0; inline-size:100%; max-inline-size:none; block-size:min(70dvh,46rem); max-block-size:none; margin:0; border:0; border-block-start:1px solid var(--border); padding:0; background:var(--settings-bar-surface,#fff); color:var(--settings-bar-text,#111); box-shadow:0 -20px 60px rgb(15 23 42/.18); }
  .pattern-advanced::backdrop { background:rgb(15 23 42/.35); backdrop-filter:blur(2px); }
  .pattern-advanced__surface { display:grid; grid-template-rows:auto minmax(0,1fr) auto; block-size:100%; }
  header { display:flex; align-items:center; justify-content:space-between; gap:16px; border-block-end:1px solid var(--border); padding:12px 18px; }
  header div { display:grid; gap:2px; } header span { color:var(--muted-foreground); font-size:9px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; } h2 { margin:0; font-size:15px; }
  header button { display:grid; place-items:center; inline-size:40px; block-size:40px; border:1px solid var(--border); border-radius:8px; background:transparent; color:inherit; cursor:pointer; }
  .pattern-advanced__editors { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); min-block-size:0; overflow:hidden; }
  section { min-inline-size:0; overflow:auto; padding:14px 18px; } section + section { border-inline-start:1px solid var(--border); }
  footer { border-block-start:1px solid var(--border); padding:8px 18px; } footer p { margin:0; color:var(--muted-foreground); font-size:10px; }
  @media(max-width:720px) { .pattern-advanced { block-size:88dvh; } .pattern-advanced__editors { grid-template-columns:1fr; overflow:auto; } section { overflow:visible; } section + section { border-inline-start:0; border-block-start:1px solid var(--border); } }
</style>
