---
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<div class="pattern-html-editor">
  <div class="pattern-html-editor__toolbar">
    <span>Semantic markup</span>
    <button type="button" data-pattern-copy-html>Copy HTML</button>
  </div>
  <label class="pattern-html-editor__label" for="pattern-html-source">Pattern HTML</label>
  <textarea id="pattern-html-source" name="patternHtml" rows="10" readonly spellcheck="false" data-pattern-html-source>{html}</textarea>
</div>

<style>
  .pattern-html-editor { display:grid; gap:7px; min-inline-size:0; padding-block:3px; }
  .pattern-html-editor__toolbar { display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--settings-bar-muted); font-size:9px; font-weight:700; }
  .pattern-html-editor__toolbar button { position:relative; min-block-size:30px; border:1px solid var(--settings-bar-border); border-radius:var(--radius-s); padding:0 8px; background:var(--settings-bar-surface); color:var(--settings-bar-text); font-size:10px; font-weight:700; }
  .pattern-html-editor__toolbar button:hover { border-color:var(--settings-bar-accent); color:var(--settings-bar-accent); }
  .pattern-html-editor__toolbar button:focus-visible { outline:2px solid var(--settings-bar-accent); outline-offset:2px; }
  .pattern-html-editor__label { position:absolute; inline-size:1px; block-size:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .pattern-html-editor textarea { inline-size:100%; min-block-size:12rem; resize:vertical; border:1px solid var(--settings-bar-border); border-radius:var(--radius-m); padding:8px; background:color-mix(in oklch,var(--settings-bar-text) 3%,var(--settings-bar-surface)); color:var(--settings-bar-text); font:500 10px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace; tab-size:2; }
  .pattern-html-editor textarea:focus-visible { outline:2px solid var(--settings-bar-accent); outline-offset:2px; }
  @media (pointer:coarse) { .pattern-html-editor__toolbar button::after { position:absolute; inset:50% auto auto 50%; inline-size:max(100%,48px); block-size:max(100%,48px); content:""; transform:translate(-50%,-50%); } }
</style>
