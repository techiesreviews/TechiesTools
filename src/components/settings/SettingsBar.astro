---
interface Props {
  path: string;
  title: string;
  ariaLabel: string;
}

const { path, title, ariaLabel } = Astro.props;
const hasHeaderAction = Astro.slots.has("headerAction");
const hasFooter = Astro.slots.has("footer");
---

<aside class="settings-bar" aria-label={ariaLabel} data-settings-bar data-has-footer={hasFooter ? "" : undefined}>
  <header class="settings-bar__header">
    <div><p>{path} /</p><h2>{title}</h2></div>
    {hasHeaderAction && <div class="settings-bar__header-action"><slot name="headerAction" /></div>}
  </header>
  <div class="settings-bar__content"><slot name="content" /></div>
  {hasFooter && <footer class="settings-bar__footer"><slot name="footer" /></footer>}
</aside>

<style>
  .settings-bar { --settings-bar-inline-size:320px; --settings-bar-surface:var(--semantic-surface); --settings-bar-border:var(--border); --settings-bar-text:var(--foreground); --settings-bar-muted:var(--muted-foreground); --settings-bar-accent:var(--primary); box-sizing:border-box; isolation:isolate; display:grid; grid-template-rows:auto minmax(0,1fr); inline-size:min(var(--settings-bar-inline-size),100vw); block-size:100%; min-block-size:0; border-inline-end:1px solid var(--settings-bar-border); background:var(--settings-bar-surface); color:var(--settings-bar-text); font:500 12px/1.25 var(--font-body); }
  .settings-bar[data-has-footer] { grid-template-rows:auto minmax(0,1fr) auto; }
  .settings-bar * { box-sizing:border-box; }
  .settings-bar button,.settings-bar input,.settings-bar select { font:inherit; color:inherit; }
  .settings-bar__header { position:sticky; inset-block-start:0; z-index:3; display:flex; align-items:center; justify-content:space-between; gap:8px; min-block-size:56px; padding:10px; background:var(--settings-bar-surface); }
  .settings-bar__header p,.settings-bar__header h2 { margin:0; }
  .settings-bar__header p { color:var(--settings-bar-muted); font-size:9px; font-weight:700; }
  .settings-bar__header h2 { font-size:16px; line-height:1.05; }
  .settings-bar__header-action { display:flex; flex:0 0 auto; }
  .settings-bar__header-action :global(button) { border:0; padding:3px 0; background:transparent; color:var(--settings-bar-muted); font-size:9px; font-weight:700; cursor:pointer; }
  .settings-bar__header-action :global(button:hover) { color:var(--settings-bar-accent); }
  .settings-bar__header-action :global([data-settings-recovery]) { position:relative; min-block-size:32px; border:1px solid oklch(86.9% 0.02 260); border-radius:6px; padding:0 10px; background:white; color:oklch(20% 0.02 260); font:700 12px/1 system-ui,sans-serif; }
  .settings-bar__header-action :global([data-settings-recovery]:hover) { border-color:oklch(55% 0.03 260); background:oklch(98% 0.005 260); color:oklch(20% 0.02 260); }
  .settings-bar__header-action :global([data-settings-recovery]:focus-visible) { outline:3px solid oklch(54.6% 0.215 262.9); outline-offset:2px; }
  .settings-bar__header-action :global([data-settings-recovery]::after) { position:absolute; inset:50% auto auto 50%; inline-size:max(100%,48px); block-size:max(100%,48px); content:""; transform:translate(-50%,-50%); }
  .settings-bar__content { position:relative; z-index:1; min-block-size:0; overflow:auto; padding:0 10px; scrollbar-gutter:stable; }
  .settings-bar:has(:popover-open) .settings-bar__content { overflow:hidden; }
  .settings-bar__footer { position:relative; z-index:2; padding:0 10px 12px; background:var(--settings-bar-surface); }
  @media (pointer:fine) { .settings-bar__header-action :global([data-settings-recovery]::after) { display:none; } }
</style>
