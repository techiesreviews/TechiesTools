---
import { Copy } from "@lucide/astro";

interface Props {
  openDataAttribute: `data-${string}`;
  copyDataAttribute: `data-${string}`;
  copyLabel: string;
  copyTitle?: string;
  openLabel?: string;
}

const {
  openDataAttribute,
  copyDataAttribute,
  copyLabel,
  copyTitle = copyLabel,
  openLabel = "Export",
} = Astro.props;
const openAttributes = { [openDataAttribute]: "" };
const copyAttributes = { [copyDataAttribute]: "" };
---

<div class="settings-export-actions">
  <button
    class="settings-export-actions__open"
    type="button"
    data-settings-export-open
    {...openAttributes}
  >{openLabel}</button>
  <button
    class="settings-export-actions__copy"
    type="button"
    aria-label={copyLabel}
    title={copyTitle}
    data-settings-export-copy
    {...copyAttributes}
  >
    <Copy size={14} stroke-width={2} aria-hidden="true" />
  </button>
</div>

<style>
  .settings-export-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 34px;
    gap: 6px;
  }

  .settings-export-actions__open {
    width: 100%;
    height: 32px;
    border: 0;
    border-radius: 6px;
    background: var(--semantic-text);
    color: var(--semantic-surface);
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
  }

  .settings-export-actions__copy {
    display: grid;
    width: 34px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0;
    background: var(--card);
    color: var(--muted-foreground);
    cursor: pointer;
    place-items: center;
  }

  .settings-export-actions__open:hover,
  .settings-export-actions__open:focus-visible {
    background: color-mix(in oklch, var(--semantic-text) 88%, var(--semantic-surface));
  }

  .settings-export-actions__copy:hover,
  .settings-export-actions__copy:focus-visible {
    border-color: var(--semantic-action);
    color: var(--semantic-action);
  }

  .settings-export-actions__open:focus-visible,
  .settings-export-actions__copy:focus-visible {
    outline: 2px solid var(--semantic-focus);
    outline-offset: 2px;
  }
</style>
