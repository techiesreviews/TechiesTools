---
import { ExternalLink } from "@lucide/astro";
import { getCollection } from "astro:content";
import SettingsAccordion from "../settings/SettingsAccordion.astro";
import FrameworkCombobox, { type ComboboxGroup } from "./FrameworkCombobox.astro";
import TreatmentCssEditor from "./TreatmentCssEditor.astro";
import { canonicalFrameworkRoute } from "../../framework/routes";
import { treatmentModules } from "../../framework/treatments/index";
import { buildElementCatalog } from "../../framework/catalog/index";
import { starterTokenRegistry } from "../../framework/starter/index";

const elementReferencePath = canonicalFrameworkRoute("elements")!.path;

const guidance = (await getCollection("elements")).map((entry) => ({ id: entry.id, ...entry.data }));
const catalogResult = buildElementCatalog({
  guidance,
  treatments: treatmentModules,
  tokens: starterTokenRegistry,
});
if (!catalogResult.success) throw new Error(catalogResult.diagnostics.map((item) => item.message).join("\n"));
const catalog = catalogResult.data;
const elementGroups:ComboboxGroup[] = [...new Set(catalog.elements.map((entry) => entry.group))].map((group) => ({
  label: group,
  options: catalog.group(group).map((entry) => ({ value: entry.id, label: entry.title, meta: `${entry.group} › <${entry.id}>`, preview: entry.id, previewType: "tag" as const })),
}));
const ruleLabels:Record<string,string>={
  base:"Base",
  hover:"Hover",
  "focus-visible":"Focus visible",
  active:"Active",
  quiet:"Quiet",
  disabled:"Disabled",
  secondary:"Secondary",
  "link-in-navigation/current":"Current navigation",
};
const treatmentElements = catalog.elements.filter((entry) => entry.definition).map((entry) => ({
  id: entry.id,
  title: entry.title,
  rules: entry.rules.map(({ path, rule }) => {
    const key = path.slice(entry.id.length + 1);
    return { key, label: ruleLabels[key] ?? rule.id, selector: rule.selector };
  }),
}));
const treatmentElementIds = treatmentElements.map((entry) => entry.id);
const elementData = Object.fromEntries(catalog.elements.map((entry) => [entry.id, { title: entry.title, intent: entry.group }]));
---
<div class="elements-editor" data-elements-editor data-element-reference-path={elementReferencePath} data-element-data={JSON.stringify(elementData)}>
  <SettingsAccordion id="elements" title="Elements" legacyDataAttribute="data-framework-accordion">
    <Fragment slot="summary">92 elements</Fragment>
    <FrameworkCombobox id="element-picker" label="Element" placeholder="Find an intent or element" groups={elementGroups} hideLabel />
    <a class="elements-editor__open" href={`${elementReferencePath}#h1`} hidden data-element-link><span data-element-link-label>Open element</span><ExternalLink size={11}/></a>
    <article class="elements-editor__settings" hidden data-element-settings>
      <section class="elements-editor__treatment" hidden data-element-treatment data-treatment-element-ids={JSON.stringify(treatmentElementIds)}>
        <header><strong>Element treatment</strong><button type="button" data-element-reset>Reset element</button></header>
        {treatmentElements.map((entry) => (
          <fieldset hidden data-generated-treatment={entry.id}>
            <legend class="sr-only">{entry.title}</legend>
            <label class="elements-editor__state-picker">
              <span>State</span>
              <select data-treatment-state-select data-element-id={entry.id}>
                {entry.rules.map((rule) => <option value={rule.key}>{rule.label}</option>)}
              </select>
            </label>
            {entry.rules.map((rule, ruleIndex) => (
              <section data-treatment-rule={rule.key} hidden={ruleIndex > 0 ? true : undefined}>
                <TreatmentCssEditor elementId={entry.id} ruleId={rule.key} selector={rule.selector} label={rule.label} />
              </section>
            ))}
          </fieldset>
        ))}
      </section>
      <p data-native-element-note>Native Fallback. No visual Framework treatment is authored.</p>
    </article>
  </SettingsAccordion>
</div>
<script>
  import { emitFrameworkEvent, onFrameworkEvent } from "../../framework/events";
  import { elementSelectionView, noElementSelection, restoreElementSelection, selectElement, selectTreatmentRule, type ElementSelectionCatalog } from "../../framework/element-selection";
  import { onElementEvent } from "../../shared/element-events";

  const editor = document.querySelector<HTMLElement>("[data-elements-editor]");
  const settings = editor?.querySelector<HTMLElement>("[data-element-settings]");
  const treatmentPanel = editor?.querySelector<HTMLElement>("[data-element-treatment]");
  const picker = editor?.querySelector<HTMLElement>('[data-combobox-id="element-picker"]');
  const link = editor?.querySelector<HTMLAnchorElement>("[data-element-link]");
  const catalog: ElementSelectionCatalog = {
    elements: JSON.parse(editor?.dataset.elementData ?? "{}"),
    treatmentIds: JSON.parse(treatmentPanel?.dataset.treatmentElementIds ?? "[]"),
    referencePath: editor?.dataset.elementReferencePath ?? "",
  };
  // The selection lives here; the DOM only renders it.
  let selection = noElementSelection;

  const render = (label?: string) => {
    const view = elementSelectionView(catalog, selection, label);
    if (view.selected) editor?.setAttribute("data-selected-element", view.selected);
    else editor?.removeAttribute("data-selected-element");
    if (settings) settings.hidden = !view.selected;
    if (treatmentPanel) treatmentPanel.hidden = !view.hasTreatment;
    if (view.selected) treatmentPanel?.setAttribute("data-treatment-element", view.selected);
    else treatmentPanel?.removeAttribute("data-treatment-element");
    treatmentPanel?.querySelectorAll<HTMLElement>("[data-generated-treatment]").forEach((set) => { set.hidden = set.dataset.generatedTreatment !== view.selected; });
    const nativeNote = editor?.querySelector<HTMLElement>("[data-native-element-note]");
    if (nativeNote) nativeNote.hidden = view.hasTreatment;
    if (link) {
      link.hidden = !view.link;
      if (view.link) link.href = view.link.href;
      const linkLabel = link.querySelector<HTMLElement>("[data-element-link-label]");
      if (linkLabel && view.link) linkLabel.textContent = view.link.label;
    }
    const input = picker?.querySelector<HTMLInputElement>("[data-combobox-input]");
    const meta = picker?.querySelector<HTMLElement>("[data-combobox-value]");
    if (input) input.value = view.pickerLabel;
    if (meta) meta.textContent = view.pickerMeta;
    picker?.querySelectorAll<HTMLElement>("[data-combobox-option]").forEach((option) => option.setAttribute("aria-selected", String(option.dataset.value === view.selected)));
    if (!view.selected) {
      const preview = picker?.querySelector<HTMLElement>("[data-combobox-selected-preview]");
      if (preview) preview.hidden = true;
      picker?.querySelector<HTMLElement>("[data-combobox-search-icon]")?.removeAttribute("hidden");
    }
    if (view.selected && view.treatmentRule !== null) {
      const stateSelect = editor?.querySelector<HTMLSelectElement>(`[data-treatment-state-select][data-element-id="${CSS.escape(view.selected)}"]`);
      if (stateSelect) {
        stateSelect.value = view.treatmentRule;
        stateSelect.closest("fieldset")?.querySelectorAll<HTMLElement>("[data-treatment-rule]").forEach((section) => { section.hidden = section.dataset.treatmentRule !== view.treatmentRule; });
      }
    }
  };
  const publish = () => emitFrameworkEvent("framework-elements:state-change", selection);

  onElementEvent(editor, "framework-combobox:select", (detail) => {
    if (detail?.id !== "element-picker") return;
    const next = selectElement(catalog, selection, detail.value);
    if (next === selection) return;
    selection = next;
    render(detail.label);
    if (selection.treatmentRule !== null) emitFrameworkEvent("framework-elements:request-state");
    publish();
  });
  editor?.querySelectorAll<HTMLSelectElement>("[data-treatment-state-select]").forEach((stateSelect) => stateSelect.addEventListener("change", () => {
    selection = selectTreatmentRule(selection, stateSelect.value);
    render();
    emitFrameworkEvent("framework-elements:request-state", { reason: "state" });
    publish();
  }));
  editor?.querySelector("[data-element-reset]")?.addEventListener("click", () => {
    if (selection.selectedElement) emitFrameworkEvent("framework-elements:reset-element", { elementId: selection.selectedElement });
  });
  onFrameworkEvent("framework-elements:apply-ui-state", (stored) => {
    selection = restoreElementSelection(catalog, stored);
    render();
    if (selection.treatmentRule !== null) emitFrameworkEvent("framework-elements:request-state");
  });
</script>
<style>
  .elements-editor__treatment { display:grid; gap:8px; min-width:0; }
  .elements-editor__treatment > header { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:24px; padding-inline:2px; }
  .elements-editor__treatment > header > strong { color:var(--ink); font-size:10px; font-weight:800; letter-spacing:.01em; }
  .elements-editor__treatment > header > button { border:0; padding:3px 0; background:transparent; color:var(--muted); font-size:9px; font-weight:700; cursor:pointer; }
  .elements-editor__treatment > header > button:hover,.elements-editor__treatment > header > button:focus-visible { color:var(--accent); }
  .elements-editor__treatment > header > button:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  .elements-editor__treatment fieldset { display:grid; gap:18px; min-inline-size:0; margin:0; overflow:visible; border:0; padding:0; background:transparent; }
  .elements-editor__treatment fieldset > legend { float:none; width:auto; border:0; padding:0; background:transparent; color:var(--accent); font-size:10px; font-weight:850; }
  .elements-editor__treatment [data-treatment-rule] { clear:both; display:grid; grid-template-columns:minmax(0,1fr); gap:8px; border:0; padding:0; }
  .elements-editor__state-picker { display:grid; gap:4px; color:var(--muted); font-size:9px; font-weight:700; }
  .elements-editor__state-picker select { width:100%; min-width:0; height:32px; border:1px solid var(--line); border-radius:6px; padding:0 25px 0 8px; background:#fff; color:var(--ink); font-size:10px; font-weight:700; }
  .elements-editor__state-picker select:focus-visible { border-color:var(--accent); outline:2px solid color-mix(in srgb,var(--accent) 22%,transparent); outline-offset:1px; }
</style>
<style>.elements-editor__open{display:flex;align-items:center;justify-content:flex-end;gap:4px;margin-top:-1px;color:var(--accent);font-size:9px;font-weight:800}.elements-editor__settings{display:grid;gap:16px;margin-top:0;padding:4px 2px 2px}</style>
