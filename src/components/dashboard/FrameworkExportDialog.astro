---
import { X } from "@lucide/astro";
import SettingsExportActions from "../settings/SettingsExportActions.astro";
import SettingsExportChoiceSet from "../settings/SettingsExportChoiceSet.astro";
import SettingsExportCodePreview from "../settings/SettingsExportCodePreview.astro";
import SettingsExportDialog from "../settings/SettingsExportDialog.astro";
import SettingsExportDialogBody from "../settings/SettingsExportDialogBody.astro";

const frameworkExportChoices = [
  { index: 1, name: "tokens.css", meta: "Variables", value: "tokens", selected: true },
  { index: 2, name: "elements.css", meta: "Requires tokens", value: "elements" },
  { index: 3, name: "utilities.css", meta: "Shared defaults", value: "utilities" },
  { index: 4, name: "components.css", meta: "Requires utilities", value: "components" },
  { index: 5, name: "context.md", meta: "Self-contained", value: "context" },
] as const;
---

<div class="framework-export" data-framework-export>
  <SettingsExportActions
    openDataAttribute="data-export-open"
    copyDataAttribute="data-export-direct-copy"
    copyLabel="Copy selected Framework artifact"
  />

  <SettingsExportDialog
    titleId="framework-export-title"
    eyebrow="Framework export"
    title="Choose a file"
    meta="Preparing version…"
    dialogDataAttribute="data-export-dialog"
    closeDataAttribute="data-export-close"
    metaDataAttribute="data-export-version"
    feedbackDataAttribute="data-export-feedback"
  >
    <SettingsExportDialogBody sidebarLabel="Framework artifacts">
      <Fragment slot="sidebar">
        <SettingsExportChoiceSet
          choices={frameworkExportChoices}
          selectDataAttribute="data-export-file"
          copyDataAttribute="data-export-copy"
          saveDataAttribute="data-export-save"
          downloadAllDataAttribute="data-export-all"
          downloadAllChoiceValue="context"
          cardDataAttribute="data-export-file-card"
          metaDataAttribute="data-export-meta"
          checkDataAttribute="data-export-check"
          diagnosticDataAttribute="data-export-card-diagnostic"
        />
      </Fragment>

      <SettingsExportCodePreview
        title="tokens.css"
        titleDataAttribute="data-export-preview-name"
        codeDataAttribute="data-export-code"
        initialCode="Preparing validated Framework output…"
      >
        <p class="framework-export__diagnostic" hidden role="alert" data-export-diagnostic></p>
        <section class="framework-export__contrast" hidden data-contrast-advisory>
          <div>
            <p><strong>Contrast can be improved.</strong></p>
            <button type="button" data-contrast-show>See improvements</button>
          </div>
        </section>
      </SettingsExportCodePreview>
    </SettingsExportDialogBody>

      <dialog class="framework-export__improvements" aria-labelledby="framework-contrast-title" data-contrast-dialog>
        <section class="framework-export__improvements-surface">
          <button class="framework-export__improvements-close" type="button" aria-label="Close contrast improvements" data-contrast-close><X size={15} /></button>
          <header>
            <p>Contrast improvement</p>
            <h3 id="framework-contrast-title">Review affected element</h3>
          </header>
          <div class="framework-export__improvements-body">
            <div class="framework-export__affected">
              <span>Element</span>
              <code data-contrast-element></code>
              <p data-contrast-measurement></p>
              <a href="#button" data-contrast-reference>View element in reference</a>
            </div>
            <p>Choose one existing-token fix, or continue without changing the Framework.</p>
            <div class="framework-export__repairs" data-contrast-repairs></div>
          </div>
          <footer><button type="button" data-contrast-cancel>Cancel and continue export</button></footer>
        </section>
      </dialog>

  </SettingsExportDialog>
</div>

<script>
  import type { Diagnostic } from "../../framework/model/index.ts";
  import type { OutputChannel, TextArtifact } from "../../framework/compiler/index.ts";
  import type { ContrastAdvisory } from "../../framework/accessibility/index.ts";
  import { connectExportDialog, exportDialogAttributes } from "../../settings/export-dialog.ts";
  import { emitFrameworkEvent, onFrameworkEvent, type FrameworkOutputs } from "../../framework/events.ts";

  type ArtifactId = "tokens" | "elements" | "utilities" | "components" | "context";
  type Channel = OutputChannel<TextArtifact>;
  type ExportState = {
    artifacts?: Record<ArtifactId, Channel>;
    identity?: { frameworkVersion: string; contentHash: string };
    diagnostics?: readonly Diagnostic[];
    accessibilityAdvisories?: readonly ContrastAdvisory[];
  };

  const root = document.querySelector<HTMLElement>("[data-framework-export]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-export-dialog]");
  const improvementsDialog = root?.querySelector<HTMLDialogElement>("[data-contrast-dialog]");
  const diagnostic = root?.querySelector<HTMLElement>("[data-export-diagnostic]");
  const artifactIds = ["tokens", "elements", "utilities", "components", "context"] as const;
  const artifactNames: Record<ArtifactId, TextArtifact["name"]> = {
    tokens: "tokens.css",
    elements: "elements.css",
    utilities: "utilities.css",
    components: "components.css",
    context: "context.md",
  };
  const artifactDescriptions: Record<ArtifactId, string> = {
    tokens: "Variables",
    elements: "Requires tokens",
    utilities: "Shared defaults",
    components: "Requires utilities",
    context: "Self-contained",
  };
  let state: ExportState = {};
  let pendingExport: { action: () => unknown; requiredArtifact?: ArtifactId } | null = null;

  const channel = (id: ArtifactId) => state.artifacts?.[id];
  const formatBytes = (value: string) => {
    const bytes = new TextEncoder().encode(value).length;
    return bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(1)} KB`;
  };
  const feedback = (message: string, assertive = false) => {
    const node = root?.querySelector<HTMLElement>("[data-export-feedback]");
    if (!node) return;
    node.setAttribute("aria-live", assertive ? "assertive" : "polite");
    node.textContent = message;
    window.setTimeout(() => { node.textContent = ""; }, 1600);
  };
  const firstProblem = (id: ArtifactId) => {
    const item = channel(id);
    return item && !item.available ? item.diagnostics[0] : undefined;
  };
  const renderFramework = (selected: ArtifactId) => {
    const problem = firstProblem(selected);
    const version = root?.querySelector<HTMLElement>("[data-export-version]");
    if (version) version.textContent = state.identity ? `Version ${state.identity.frameworkVersion}` : "Preparing version…";
    const previewName = root?.querySelector<HTMLElement>("[data-export-preview-name]");
    if (previewName) previewName.textContent = artifactNames[selected];
    if (diagnostic) {
      diagnostic.hidden = !problem;
      diagnostic.textContent = problem ? `${problem.message} ${problem.repair}` : "";
    }
    artifactIds.forEach((id) => {
      const item = channel(id);
      const available = item?.available === true;
      const itemProblem = firstProblem(id);
      const card = root?.querySelector<HTMLElement>(`[data-export-file-card="${id}"]`);
      card?.toggleAttribute("data-unavailable", Boolean(item && !available));
      card?.querySelector<HTMLElement>("[data-export-check]")?.toggleAttribute("hidden", !available);
      const meta = root?.querySelector<HTMLElement>(`[data-export-meta="${id}"]`);
      if (meta) meta.textContent = available ? `${artifactDescriptions[id]} · ${formatBytes(item.value.value)}` : artifactDescriptions[id];
      const cardDiagnostic = root?.querySelector<HTMLElement>(`[data-export-card-diagnostic="${id}"]`);
      if (cardDiagnostic) {
        cardDiagnostic.hidden = !itemProblem;
        cardDiagnostic.textContent = itemProblem ? `${itemProblem.message} ${itemProblem.repair}` : "";
      }
    });
    const allAvailable = Boolean(state.artifacts && Object.values(state.artifacts).every((item) => item.available));
    root?.querySelector<HTMLButtonElement>("[data-export-all]")?.toggleAttribute("disabled", !allAvailable);
    const contrast = root?.querySelector<HTMLElement>("[data-contrast-advisory]");
    if (contrast) contrast.hidden = !state.accessibilityAdvisories?.length;
  };
  const validate = () => emitFrameworkEvent("framework-export:request");
  const firstAdvisory = () => state.accessibilityAdvisories?.[0];
  const renderImprovements = () => {
    const advisory = firstAdvisory();
    const repairs = root?.querySelector<HTMLElement>("[data-contrast-repairs]");
    const element = root?.querySelector<HTMLElement>("[data-contrast-element]");
    const measurement = root?.querySelector<HTMLElement>("[data-contrast-measurement]");
    const reference = root?.querySelector<HTMLAnchorElement>("[data-contrast-reference]");
    if (!repairs || !element || !measurement || !reference || !advisory) return;
    element.textContent = `<${advisory.elementId}>`;
    measurement.textContent = advisory.ratio === null
      ? advisory.reason ?? `Required WCAG threshold: ${advisory.threshold}:1.`
      : `Current ${advisory.ratio.toFixed(2)}:1 · Required ${advisory.threshold}:1.`;
    reference.href = `#${advisory.elementId}`;
    const repairButtons = advisory.repairs.map((repair) => {
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = `${repair.rulePath} · ${repair.property}: ${repair.tokenId} — ${repair.rating}`;
      button.addEventListener("click", () => emitFrameworkEvent("framework-accessibility:accept", { repair }));
      return button;
    });
    if (!repairButtons.length) {
      const message = document.createElement("p");
      message.textContent = advisory.reason ?? "No compatible existing Token reaches the required WCAG threshold.";
      repairs.replaceChildren(message);
    } else repairs.replaceChildren(...repairButtons);
    if (!improvementsDialog?.open) improvementsDialog?.showModal();
  };

  if (root) {
    // Contrast review gates every copy and save; unavailable artifacts open the dialog on their diagnostic instead.
    const continueWithContrastDecision = (action: () => unknown, requiredArtifact?: ArtifactId) => {
      validate();
      if (requiredArtifact && !channel(requiredArtifact)?.available) {
        exportDialog.select(requiredArtifact);
        if (!dialog?.open) dialog?.showModal();
        return;
      }
      if (!firstAdvisory()) {
        void action();
        return;
      }
      pendingExport = { action, requiredArtifact };
      if (!dialog?.open) dialog?.showModal();
      renderImprovements();
    };
    const exportDialog = connectExportDialog<ArtifactId>({
      root,
      attributes: exportDialogAttributes("data-export"),
      initial: "tokens",
      artifact: (id) => {
        const item = channel(id);
        return item?.available ? item.value : undefined;
      },
      placeholder: (id) => {
        const problem = firstProblem(id);
        return problem ? `${problem.message}\n\nRepair: ${problem.repair}` : "Preparing validated Framework output…";
      },
      // Packaging validates first; the result arrives through framework-export:package-ready.
      packageAll: () => {
        emitFrameworkEvent("framework-export:package");
        return undefined;
      },
      packageName: () => "framework.zip",
      report: feedback,
      beforeOpen: validate,
      gate: continueWithContrastDecision,
      afterRender: renderFramework,
    });

    onFrameworkEvent("framework-elements:outputs", (outputs: FrameworkOutputs | undefined) => {
      state = outputs ?? {};
      root.setAttribute("data-framework-content-hash", state.identity?.contentHash ?? "");
      exportDialog.select(exportDialog.selected);
    });
    onFrameworkEvent("framework-export:package-ready", (result) => {
      if (result) exportDialog.actions.deliver(result);
    });
    onFrameworkEvent("framework-export:package-failed", (detail) => {
      const message = detail?.message ?? "The package could not be created.";
      feedback(`Could not start download for framework.zip. ${message}`, true);
    });
    onFrameworkEvent("framework-accessibility:accepted", () => {
      improvementsDialog?.close();
      const pending = pendingExport;
      pendingExport = null;
      if (pending) continueWithContrastDecision(pending.action, pending.requiredArtifact);
    });
    onFrameworkEvent("framework-accessibility:failed", () => {
      feedback("Could not apply that contrast improvement. Review the current options and retry.", true);
    });
    const cancelImprovements = () => {
      const pending = pendingExport;
      pendingExport = null;
      if (improvementsDialog?.open) improvementsDialog.close();
      if (pending) void pending.action();
    };
    root.querySelector("[data-contrast-show]")?.addEventListener("click", renderImprovements);
    root.querySelector("[data-contrast-cancel]")?.addEventListener("click", cancelImprovements);
    root.querySelector("[data-contrast-close]")?.addEventListener("click", cancelImprovements);
    root.querySelector("[data-contrast-reference]")?.addEventListener("click", () => { improvementsDialog?.close(); dialog?.close(); });
    improvementsDialog?.addEventListener("click", (event) => { if (event.target === improvementsDialog) cancelImprovements(); });
    improvementsDialog?.addEventListener("cancel", cancelImprovements);
    dialog?.addEventListener("close", () => {
      pendingExport = null;
      improvementsDialog?.close();
    });
  }
</script>

<style>
  .framework-export { z-index:4; padding:10px 0 0; background:#fafbfc; }


  .framework-export__diagnostic { margin:0 0 10px; border:1px solid #fed7aa; border-radius:7px; padding:9px; background:#fff7ed; color:#9a3412; font-size:9px; }
  .framework-export__contrast { margin:0 0 10px; border:1px solid #fbbf24; border-radius:7px; padding:9px; background:#fffbeb; color:#92400e; font-size:10px; }
  .framework-export__contrast > div:first-child { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .framework-export__contrast p { margin:0; }
  .framework-export__contrast button { border:1px solid #f59e0b; border-radius:5px; padding:6px 8px; background:#fff; color:#92400e; font:750 9px/1.2 inherit; cursor:pointer; }
  .framework-export__improvements { width:min(520px,calc(100vw - 48px)); max-height:calc(100vh - 48px); border:0; border-radius:12px; padding:0; background:transparent; }
  .framework-export__improvements::backdrop { background:rgb(17 24 39/.58); }
  .framework-export__improvements-surface { position:relative; overflow:hidden; border:1px solid #d7dce5; border-radius:12px; background:#fff; box-shadow:0 24px 70px rgb(15 23 42/.32); }
  .framework-export__improvements-close { position:absolute; top:12px; right:12px; display:grid; place-items:center; width:30px; height:30px; border:1px solid #d7dce5; border-radius:6px; background:#fff; color:#667085; cursor:pointer; }
  .framework-export__improvements header { border-bottom:1px solid #e5e7eb; padding:20px 56px 16px 20px; }
  .framework-export__improvements header p,.framework-export__improvements header h3 { margin:0; }
  .framework-export__improvements header p { color:#92400e; font-size:9px; font-weight:850; letter-spacing:.06em; text-transform:uppercase; }
  .framework-export__improvements header h3 { margin-top:3px; font-size:18px; }
  .framework-export__improvements-body { display:grid; gap:14px; padding:20px; }
  .framework-export__improvements-body > p { margin:0; color:#475467; font-size:11px; line-height:1.5; }
  .framework-export__affected { display:grid; grid-template-columns:auto 1fr; align-items:center; gap:7px 12px; border:1px solid #fde68a; border-radius:8px; padding:13px; background:#fffbeb; }
  .framework-export__affected > span { color:#92400e; font-size:9px; font-weight:850; letter-spacing:.05em; text-transform:uppercase; }
  .framework-export__affected > code { justify-self:end; color:#111827; font:750 11px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace; }
  .framework-export__affected > p { grid-column:1/-1; margin:0; color:#78350f; font-size:11px; }
  .framework-export__affected > a { grid-column:1/-1; justify-self:start; color:#174ea6; font-size:10px; font-weight:750; }
  .framework-export__repairs { display:grid; gap:8px; }
  .framework-export__repairs button { border:1px solid #d7dce5; border-radius:7px; padding:10px 12px; background:#fff; color:#172033; font-size:10px; font-weight:750; text-align:left; cursor:pointer; }
  .framework-export__repairs button:hover,.framework-export__repairs button:focus-visible { border-color:#2563eb; outline:0; background:#eff6ff; }
  .framework-export__improvements footer { display:flex; justify-content:flex-end; border-top:1px solid #e5e7eb; padding:14px 20px; }
  .framework-export__improvements footer button { border:1px solid #d7dce5; border-radius:7px; padding:8px 11px; background:#fff; color:#475467; font-size:10px; font-weight:750; cursor:pointer; }


</style>
