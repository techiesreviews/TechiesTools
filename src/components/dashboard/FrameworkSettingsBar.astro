  .framework-viewport .framework-field { padding:0; border:0; }
  .framework-viewport .framework-field:first-child { border-right:0; }
  .settings-bar { --line:var(--settings-bar-border); --muted:var(--settings-bar-muted); --ink:var(--settings-bar-text); --accent:var(--settings-bar-accent); }
  .framework-controls { display:grid; align-content:start; min-height:0; }
  .framework-color-summary { display:flex; align-items:center; justify-content:flex-end; gap:3px; overflow:visible; }
