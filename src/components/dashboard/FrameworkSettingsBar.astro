---
import { ChevronDown, Plus } from "@lucide/astro";
import SettingsBar from "../settings/SettingsBar.astro";
import SettingsAccordion from "../settings/SettingsAccordion.astro";
import FrameworkColorRow from "./FrameworkColorRow.astro";
import FrameworkExportDialog from "./FrameworkExportDialog.astro";
import ElementsAccordion from "./ElementsAccordion.astro";
import FrameworkCombobox, { type ComboboxGroup } from "./FrameworkCombobox.astro";
import { fallbackGoogleFontCatalog, fontOptionsForRole, type GoogleFontRole } from "../../framework/fonts/catalog.ts";
import { starterControl, starterManualTokens, starterSemanticRoles, starterSettings } from "../../framework/primitives/starter-settings.ts";

const ratios = [
  ["1.067", "Minor Second"],
  ["1.125", "Major Second"],
  ["1.200", "Minor Third"],
  ["1.250", "Major Third"],
  ["1.333", "Perfect Fourth"],
  ["1.500", "Perfect Fifth"],
];
const fontGroups = (role: GoogleFontRole): ComboboxGroup[] => [{
  label: "Google Fonts",
  options: fontOptionsForRole(fallbackGoogleFontCatalog, role).map(({ category: _category, ...option }) => option),
}];
const starterSemanticGroups:ComboboxGroup[]=[{label:"Palette tokens",options:[
  {value:"--color-primary-lightest",label:"Primary / Lightest",meta:"--color-primary-lightest",preview:"#f8f9ff",previewType:"color"},
  {value:"--color-primary-lighter",label:"Primary / Lighter",meta:"--color-primary-lighter",preview:"#eef2ff",previewType:"color"},
  {value:"--color-primary-light",label:"Primary / Light",meta:"--color-primary-light",preview:"#c7d2fe",previewType:"color"},
  {value:"--color-primary",label:"Primary / Base",meta:"--color-primary",preview:"#2563eb",previewType:"color"},
  {value:"--color-primary-dark",label:"Primary / Dark",meta:"--color-primary-dark",preview:"#1d4ed8",previewType:"color"},
  {value:"--color-primary-darker",label:"Primary / Darker",meta:"--color-primary-darker",preview:"#1e3a8a",previewType:"color"},
  {value:"--color-primary-darkest",label:"Primary / Darkest",meta:"--color-primary-darkest",preview:"#172554",previewType:"color"},
  {value:"oklch(0% 0 0)",label:"Black",meta:"oklch(0% 0 0)",preview:"#000",previewType:"color"},
  {value:"oklch(100% 0 0)",label:"White",meta:"oklch(100% 0 0)",preview:"#fff",previewType:"color"},
]}];
const semanticDefaults:Record<string,string>=starterSemanticRoles;
---

<SettingsBar path="Tools" title="Framework" ariaLabel="Framework settings">
  <button slot="headerAction" type="button" data-framework-reset data-settings-recovery>Reset</button>
  <Fragment slot="content">
  <section class="framework-viewport" aria-labelledby="framework-viewport-title">
    <header class="framework-card__header"><strong id="framework-viewport-title">Fluid viewport</strong><span data-viewport-range-label>320 → 1440 px</span></header>
    <div class="framework-field-pair">
      <label class="framework-field"><span>Minimum</span><span class="framework-control framework-control--unit"><input type="number" min="240" max="1920" step="1" value={starterControl("data-fluid-min-width")} data-fluid-min-width /><i>px</i></span></label>
      <label class="framework-field"><span>Maximum</span><span class="framework-control framework-control--unit"><input type="number" min="480" max="3840" step="1" value={starterControl("data-fluid-max-width")} data-fluid-max-width /><i>px</i></span></label>
    </div>
  </section>

  <div class="framework-controls" data-framework-settings data-settings-accordion-group>
    <SettingsAccordion id="colors" title="Colors" open summaryClass="framework-color-summary" summaryDataAttribute="data-color-summary" legacyDataAttribute="data-framework-accordion">
      <Fragment slot="summary"><span>color ·</span><i style="--summary-color:#2563EB"></i></Fragment>
        <label class="framework-field framework-field--stack"><span>Naming convention</span><span class="framework-control"><input type="text" value={starterControl("data-color-convention")} data-color-convention /></span><small hidden data-color-convention-error>Conflicts with another generated token. Using a safe color suffix.</small></label>
        <div class="framework-colors__list" data-color-list>
          <FrameworkColorRow name={starterSettings.colors[0].name} value={starterSettings.colors[0].hex} removable={false} />
        </div>
        <template data-color-row-template><FrameworkColorRow name="Color __INDEX__" value="#7C3AED" /></template>
        <button class="framework-button framework-colors__add" type="button" data-add-color><Plus size={13} stroke-width={2} /> Add color</button>
    </SettingsAccordion>

    <SettingsAccordion id="semantics" title="Semantic colors" summaryDataAttribute="data-semantic-summary" legacyDataAttribute="data-framework-accordion">
      <Fragment slot="summary">semantic · 6 roles</Fragment>
        <label class="framework-field framework-field--stack"><span>Naming convention</span><span class="framework-control"><input type="text" value={starterControl("data-semantic-convention")} data-semantic-convention /></span><small hidden data-semantic-convention-error>Must differ from Colors. Using a safe semantic suffix.</small></label>
        <div class="framework-card framework-semantic-fields">
          {["primary","action","surface","text","border","focus"].map((role) => (
            <div class="framework-semantic-field">
              <select hidden aria-label={`${role} semantic color`} data-semantic-role={role}></select>
              <FrameworkCombobox id={`semantic-role-${role}`} label={role[0].toUpperCase() + role.slice(1)} placeholder="Find palette token" groups={starterSemanticGroups} value={semanticDefaults[role]} />
            </div>
          ))}
        </div>
    </SettingsAccordion>

    <SettingsAccordion id="type" title="Typography" summaryDataAttribute="data-type-summary" legacyDataAttribute="data-framework-accordion">
      <Fragment slot="summary">text · 16–18 px</Fragment>
        <div class="framework-card">
          <label class="framework-field framework-field--inline"><span>Google Fonts<small data-google-font-status>Connecting to live catalog</small></span><input class="framework-switch" type="checkbox" checked={Boolean(starterSettings.controls["data-google-fonts"])} data-google-fonts /></label>
          <div class="framework-font-field">
            <input type="hidden" value={starterControl("data-type-family")} data-type-family />
            <FrameworkCombobox id="font-body" label="Body family" placeholder="Search Google Fonts" groups={fontGroups("body")} value={starterControl("data-type-family")} />
          </div>
          <div class="framework-font-field">
            <input type="hidden" value={starterControl("data-type-heading-family")} data-type-heading-family />
            <FrameworkCombobox id="font-heading" label="Heading family" placeholder="Search Google Fonts" groups={fontGroups("heading")} value={starterControl("data-type-heading-family")} />
          </div>
          <div class="framework-font-field">
            <input type="hidden" value={starterControl("data-type-code-family")} data-type-code-family />
            <FrameworkCombobox id="font-code" label="Code family" placeholder="Search Google Fonts" groups={fontGroups("code")} value={starterControl("data-type-code-family")} />
          </div>
        </div>
        <label class="framework-field framework-field--stack"><span>Naming convention</span><span class="framework-control"><input type="text" value={starterControl("data-type-name")} data-type-name /></span></label>
        <div class="framework-mode" role="tablist" aria-label="Typography scale mode">
          <button type="button" role="tab" aria-selected="true" data-system-mode="type" data-mode-value="automatic">Automatic</button>
          <button type="button" role="tab" aria-selected="false" data-system-mode="type" data-mode-value="manual">Manual</button>
        </div>
        <div class="framework-card" data-system-auto="type">
          <header class="framework-card__header"><strong>Fluid scale</strong><span data-type-range-label>Shared viewport</span></header>
          <div class="framework-field-pair">
            <label class="framework-field"><span>Minimum</span><span class="framework-control framework-control--unit"><input type="number" min="10" max="24" step="1" value={starterControl("data-type-min")} data-type-min /><i>px</i></span></label>
            <label class="framework-field"><span>Maximum</span><span class="framework-control framework-control--unit"><input type="number" min="12" max="32" step="1" value={starterControl("data-type-max")} data-type-max /><i>px</i></span></label>
          </div>
          <label class="framework-field framework-field--stack"><span>Scale ratio <small>Min viewport</small></span><span class="framework-control framework-control--select"><select data-type-min-ratio>{ratios.map(([value, name]) => <option value={value} selected={value === starterControl("data-type-min-ratio")}>{name} · {value}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--stack"><span>Scale ratio <small>Max viewport</small></span><span class="framework-control framework-control--select"><select data-type-max-ratio>{ratios.map(([value, name]) => <option value={value} selected={value === starterControl("data-type-max-ratio")}>{name} · {value}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--inline"><span>Base scale index<small>Anchor token</small></span><span class="framework-control framework-control--select framework-control--short"><select data-type-index>{["xs","s","m","l","xl"].map((token) => <option selected={token === starterControl("data-type-index")}>{token}</option>)}</select><ChevronDown size={13} /></span></label>
        </div>
        <div class="framework-manual" hidden data-system-manual="type">
          <p>Set each token directly.</p>
          {starterManualTokens.type.map(([token, value]) => <label><span>{token}</span><input type="number" step="1" value={value} data-manual-type={token} /><i>px</i></label>)}
        </div>
    </SettingsAccordion>

    <SettingsAccordion id="radius" title="Border radius" summaryDataAttribute="data-radius-summary" legacyDataAttribute="data-framework-accordion">
      <Fragment slot="summary">radius · 4–8 px</Fragment>
        <label class="framework-field framework-field--stack"><span>Naming convention</span><span class="framework-control"><input type="text" value={starterControl("data-radius-name")} data-radius-name /></span></label>
        <div class="framework-mode" role="tablist" aria-label="Border radius scale mode">
          <button type="button" role="tab" aria-selected="true" data-system-mode="radius" data-mode-value="automatic">Automatic</button>
          <button type="button" role="tab" aria-selected="false" data-system-mode="radius" data-mode-value="manual">Manual</button>
        </div>
        <div class="framework-card" data-system-auto="radius">
          <header class="framework-card__header"><strong>Fluid scale</strong><span data-radius-range-label>Shared viewport</span></header>
          <div class="framework-field-pair">
            <label class="framework-field"><span>Minimum</span><span class="framework-control framework-control--unit"><input type="number" min="0" max="32" step="1" value={starterControl("data-radius-min")} data-radius-min /><i>px</i></span></label>
            <label class="framework-field"><span>Maximum</span><span class="framework-control framework-control--unit"><input type="number" min="4" max="64" step="1" value={starterControl("data-radius-max")} data-radius-max /><i>px</i></span></label>
          </div>
          <label class="framework-field framework-field--stack"><span>Scale ratio <small>Min viewport</small></span><span class="framework-control framework-control--select"><select data-radius-min-ratio>{ratios.map(([value, name]) => <option value={value} selected={value === starterControl("data-radius-min-ratio")}>{name} · {value}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--stack"><span>Scale ratio <small>Max viewport</small></span><span class="framework-control framework-control--select"><select data-radius-max-ratio>{ratios.map(([value, name]) => <option value={value} selected={value === starterControl("data-radius-max-ratio")}>{name} · {value}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--inline"><span>Base scale index<small>Anchor token</small></span><span class="framework-control framework-control--select framework-control--short"><select data-radius-index>{["xs","s","m","l","xl"].map((token) => <option selected={token === starterControl("data-radius-index")}>{token}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--inline"><span>Include full<small>Add pill token</small></span><input class="framework-switch" type="checkbox" checked={Boolean(starterSettings.controls["data-radius-full"])} data-radius-full /></label>
        </div>
        <div class="framework-manual" hidden data-system-manual="radius">
          <p>Set each token directly.</p>
          {starterManualTokens.radius.map(([token, value]) => <label><span>{token}</span><input type="number" step="1" value={value} data-manual-radius={token} /><i>px</i></label>)}
        </div>
    </SettingsAccordion>

    <SettingsAccordion id="spacing" title="Spacing" summaryDataAttribute="data-spacing-summary" legacyDataAttribute="data-framework-accordion">
      <Fragment slot="summary">space · 16–20 px</Fragment>
        <label class="framework-field framework-field--stack"><span>Naming convention</span><span class="framework-control"><input type="text" value={starterControl("data-spacing-name")} data-spacing-name /></span></label>
        <div class="framework-mode" role="tablist" aria-label="Spacing scale mode">
          <button type="button" role="tab" aria-selected="true" data-system-mode="spacing" data-mode-value="automatic">Automatic</button>
          <button type="button" role="tab" aria-selected="false" data-system-mode="spacing" data-mode-value="manual">Manual</button>
        </div>
        <div class="framework-card" data-system-auto="spacing">
          <header class="framework-card__header"><strong>Fluid scale</strong><span data-spacing-range-label>Shared viewport</span></header>
          <div class="framework-field-pair">
            <label class="framework-field"><span>Minimum</span><span class="framework-control framework-control--unit"><input type="number" min="4" max="64" step="1" value={starterControl("data-spacing-min")} data-spacing-min /><i>px</i></span></label>
            <label class="framework-field"><span>Maximum</span><span class="framework-control framework-control--unit"><input type="number" min="4" max="96" step="1" value={starterControl("data-spacing-max")} data-spacing-max /><i>px</i></span></label>
          </div>
          <label class="framework-field framework-field--stack"><span>Scale ratio <small>Min viewport</small></span><span class="framework-control framework-control--select"><select data-spacing-min-ratio>{ratios.map(([value, name]) => <option value={value} selected={value === starterControl("data-spacing-min-ratio")}>{name} · {value}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--stack"><span>Scale ratio <small>Max viewport</small></span><span class="framework-control framework-control--select"><select data-spacing-max-ratio>{ratios.map(([value, name]) => <option value={value} selected={value === starterControl("data-spacing-max-ratio")}>{name} · {value}</option>)}</select><ChevronDown size={13} /></span></label>
          <label class="framework-field framework-field--inline"><span>Base scale index<small>Anchor token</small></span><span class="framework-control framework-control--select framework-control--short"><select data-spacing-index>{["xs","s","m","l","xl"].map((token) => <option selected={token === starterControl("data-spacing-index")}>{token}</option>)}</select><ChevronDown size={13} /></span></label>
        </div>
        <div class="framework-manual" hidden data-system-manual="spacing">
          <p>Set each token directly.</p>
          {starterManualTokens.spacing.map(([token, value]) => <label><span>{token}</span><input type="number" step="1" value={value} data-manual-spacing={token} /><i>px</i></label>)}
        </div>
    </SettingsAccordion>
    <ElementsAccordion />
  </div>
  </Fragment>
  <FrameworkExportDialog slot="footer" />
</SettingsBar>

<script>
  import { googleFontPreviewStylesheetUrl, type GoogleFontPreviewRequest } from "../../framework/fonts/preview.ts";
  import {
    FRAMEWORK_LEGACY_STORAGE_KEY,
    FRAMEWORK_UI_DIFF_STORAGE_KEY,
  } from "../../framework/colors/palette-preferences.ts";
  import {
    buildSemanticColorOptions,
    refreshSemanticColorRoles,
    type SemanticColorOption,
    type SemanticPaletteColor,
    type SemanticShade,
  } from "../../framework/colors/semantic-options.ts";
  import {
    normalizeFrameworkHex as normalizeHex,
  } from "../../framework/colors/palette-generation.ts";
  import { primitiveSnapshotFromSettings, settingsPalette, settingsSemanticConvention, settingsViewport } from "../../framework/primitives/snapshot.ts";
  import { starterSettings } from "../../framework/primitives/starter-settings.ts";
  import {
    parseElementUiState,
    restoreSettingsState,
    serializeSettingsDiff,
    type FrameworkSettingsState,
  } from "../../framework/primitives/settings-state.ts";
  import { emitFrameworkEvent, onFrameworkEvent, type ElementUiState } from "../../framework/events.ts";
  import { emitElementEvent, onElementEvent } from "../../shared/element-events.ts";

  const root = document.querySelector<HTMLElement>("[data-framework-settings]")?.closest<HTMLElement>("[data-settings-bar]");
  const colorList = root?.querySelector<HTMLElement>("[data-color-list]");
  const colorTemplate = root?.querySelector<HTMLTemplateElement>("[data-color-row-template]");
  let colorCount = root?.querySelectorAll("[data-color-row]").length ?? 0;
  let colorIdentity = 0;
  const ensureColorId = (row: HTMLElement) => row.dataset.colorId ||= `palette-${++colorIdentity}`;
  root?.querySelectorAll<HTMLElement>("[data-color-row]").forEach(ensureColorId);


  type GeneratedColor = SemanticPaletteColor;
  const colorRows = () => [...(root?.querySelectorAll<HTMLElement>("[data-color-row]") ?? [])];
  const LEGACY_STORAGE_KEY = FRAMEWORK_LEGACY_STORAGE_KEY;
  const UI_DIFF_KEY = FRAMEWORK_UI_DIFF_STORAGE_KEY;
  let elementUiState: ElementUiState = { selectedElement:null, treatmentRule:null };
  const fontPickers = [
    { id:"font-body", attribute:"data-type-family", role:"body", previewWeights:[400,700] },
    { id:"font-heading", attribute:"data-type-heading-family", role:"heading", previewWeights:[700] },
    { id:"font-code", attribute:"data-type-code-family", role:"code", previewWeights:[400,700] },
  ] as const;
  const loadedFontPreviewWeights = new Set<string>();
  const pendingFontPreviewWeights = new Set<string>();
  const fontPreviewKey = (family:string, weight:number) => `${family}:${weight}`;
  const loadFontPreviews = (requests:readonly GoogleFontPreviewRequest[], retry=true) => {
    const next = requests.flatMap(({ family, weights }) => {
      const missing = [...new Set(weights)].filter((weight) => {
        const key = fontPreviewKey(family, weight);
        return !loadedFontPreviewWeights.has(key) && !pendingFontPreviewWeights.has(key);
      });
      return missing.length ? [{ family, weights:missing }] : [];
    });
    const href = googleFontPreviewStylesheetUrl(next);
    if (!href) return;
    const keys = next.flatMap(({ family, weights }) => weights.map((weight) => fontPreviewKey(family, weight)));
    keys.forEach((key) => pendingFontPreviewWeights.add(key));
    const stylesheet = document.createElement("link");
    stylesheet.rel = "stylesheet";
    stylesheet.href = href;
    stylesheet.dataset.googleFontPreview = "";
    stylesheet.addEventListener("load", () => {
      keys.forEach((key) => {
        pendingFontPreviewWeights.delete(key);
        loadedFontPreviewWeights.add(key);
      });
    }, { once:true });
    stylesheet.addEventListener("error", () => {
      keys.forEach((key) => pendingFontPreviewWeights.delete(key));
      stylesheet.remove();
      if (retry) window.setTimeout(() => loadFontPreviews(next, false), 1000);
    }, { once:true });
    document.head.append(stylesheet);
  };
  type FontPickerOption = { value:string; label:string; meta?:string; preview?:string; previewType?:string; previewWeights?:number[] };
  type FontCatalogResponse = {
    source:"google"|"fallback";
    roles:Record<"body"|"heading"|"code",FontPickerOption[]>;
  };
  const syncFontPickers = () => {
    if (!root) return;
    fontPickers.forEach(({ id:pickerId, attribute }) => {
      const value = root.querySelector<HTMLInputElement>(`[${attribute}]`)?.value;
      const picker = root.querySelector<HTMLElement>(`[data-combobox-id="${pickerId}"]`);
      if (value) emitElementEvent(picker, "framework-combobox:set-value", { value });
    });
  };
  const loadGoogleFonts = async () => {
    if (!root) return;
    try {
      const response = await fetch("/api/google-fonts.json", { headers:{ Accept:"application/json" } });
      if (!response.ok) return;
      const catalog = await response.json() as FontCatalogResponse;
      const families = new Set<string>();
      fontPickers.forEach(({ id:pickerId, role, attribute }) => {
        const options = catalog.roles?.[role] ?? [];
        options.forEach((option) => families.add(option.value));
        const value = root.querySelector<HTMLInputElement>(`[${attribute}]`)?.value;
        emitElementEvent(root.querySelector<HTMLElement>(`[data-combobox-id="${pickerId}"]`), "framework-combobox:update-options", { group:"Google Fonts", options, value });
      });
      loadFontPreviews(fontPickers.flatMap(({ attribute, previewWeights }) => {
        const value = root.querySelector<HTMLInputElement>(`[${attribute}]`)?.value;
        return value ? [{ family:value, weights:previewWeights }] : [];
      }));
      const status = root.querySelector<HTMLElement>("[data-google-font-status]");
      if (status) status.textContent = catalog.source === "google"
        ? `Live API · ${families.size} families`
        : `API key needed · ${families.size} starter families`;
    } catch {
      const status = root.querySelector<HTMLElement>("[data-google-font-status]");
      if (status) status.textContent = "Catalog unavailable · starter families";
    }
  };
  const CONTROL_ATTRIBUTES = Object.keys(starterSettings.controls);
  const manualAttributes = ["data-manual-type", "data-manual-radius", "data-manual-spacing"];
  const appendColorRow = (name: string, hex: string) => {
    if (!colorTemplate || !colorList) return;
    colorCount += 1;
    const fragment = colorTemplate.content.cloneNode(true) as DocumentFragment;
    fragment.querySelectorAll<HTMLElement>("*").forEach((element) => {
      ["aria-label", "value"].forEach((attribute) => {
        const current = element.getAttribute(attribute);
        if (current?.includes("__INDEX__")) element.setAttribute(attribute, current.replaceAll("__INDEX__", String(colorCount)));
      });
    });
    const row = fragment.querySelector<HTMLElement>("[data-color-row]");
    const nameInput = row?.querySelector<HTMLInputElement>("[data-color-name]");
    const hexInput = row?.querySelector<HTMLInputElement>("[data-color-hex]");
    const picker = row?.querySelector<HTMLInputElement>("[data-color-picker]");
    const normalized = normalizeHex(hex);
    if (nameInput) nameInput.value = name;
    if (hexInput) hexInput.value = normalized;
    if (picker) picker.value = normalized;
    if (row) ensureColorId(row);
    colorList.append(fragment);
  };
  const collectState = (): FrameworkSettingsState => {
    const controls: Record<string, string | boolean> = {};
    CONTROL_ATTRIBUTES.forEach((attribute) => {
      const control = root?.querySelector<HTMLInputElement | HTMLSelectElement>(`[${attribute}]`);
      if (control) controls[attribute] = control instanceof HTMLInputElement && control.type === "checkbox" ? control.checked : control.value;
    });
    const manual: Record<string, string> = {};
    manualAttributes.forEach((attribute) => root?.querySelectorAll<HTMLInputElement>(`[${attribute}]`).forEach((control) => { manual[`${attribute}:${control.getAttribute(attribute)}`] = control.value; }));
    const modes: Record<string, string> = {};
    root?.querySelectorAll<HTMLButtonElement>("[data-system-mode][aria-selected='true']").forEach((button) => { modes[button.dataset.systemMode ?? "type"] = button.dataset.modeValue ?? "automatic"; });
    return {
      version: 1,
      controls,
      manual,
      modes,
      semantics: Object.fromEntries([...(root?.querySelectorAll<HTMLSelectElement>("[data-semantic-role]") ?? [])].map((select) => [select.dataset.semanticRole ?? "primary", select.value])),
      openAccordion: root?.querySelector<HTMLElement>("[data-framework-accordion] [data-accordion-trigger][aria-expanded='true']")?.closest<HTMLElement>("[data-framework-accordion]")?.dataset.frameworkAccordion ?? null,
      elements: elementUiState,
      colors: colorRows().map((row, index) => ({ name: row.querySelector<HTMLInputElement>("[data-color-name]")?.value || `Color ${index + 1}`, hex: normalizeHex(row.querySelector<HTMLInputElement>("[data-color-hex]")?.value || "#2563EB") })),
    };
  };
  const applyState = (state: FrameworkSettingsState) => {
    if (!root || state.version !== 1) return;
    Object.entries(state.controls ?? {}).forEach(([attribute, value]) => {
      const control = root.querySelector<HTMLInputElement | HTMLSelectElement>(`[${attribute}]`);
      if (!control) return;
      if (control instanceof HTMLInputElement && control.type === "checkbox") control.checked = Boolean(value);
      else control.value = String(value);
    });
    Object.entries(state.manual ?? {}).forEach(([key, value]) => {
      const separator = key.indexOf(":");
      const attribute = key.slice(0, separator);
      const token = key.slice(separator + 1);
      const control = root.querySelector<HTMLInputElement>(`[${attribute}="${CSS.escape(token)}"]`);
      if (control) control.value = value;
    });
    const firstRow = colorRows()[0];
    colorRows().slice(1).forEach((row) => row.remove());
    colorCount = 1;
    const colors = (state.colors?.length ? state.colors : [{ name:"Primary", hex:"#2563EB" }]).map((color, index) => ({
      ...color,
      name: index === 0 && color.name.trim().toLowerCase() === "primary color" ? "Primary" : color.name,
    }));
    const firstName = firstRow?.querySelector<HTMLInputElement>("[data-color-name]");
    const firstHex = firstRow?.querySelector<HTMLInputElement>("[data-color-hex]");
    const firstPicker = firstRow?.querySelector<HTMLInputElement>("[data-color-picker]");
    if (firstName) firstName.value = colors[0].name;
    if (firstHex) firstHex.value = normalizeHex(colors[0].hex);
    if (firstPicker) firstPicker.value = normalizeHex(colors[0].hex);
    colors.slice(1).forEach((color) => appendColorRow(color.name, color.hex));
    root.querySelectorAll<HTMLSelectElement>("[data-semantic-role]").forEach((select) => {
      select.dataset.pendingValue = state.semantics?.[select.dataset.semanticRole ?? "primary"] ?? "";
    });
    root.querySelectorAll<HTMLButtonElement>("[data-system-mode]").forEach((button) => {
      const selected = (state.modes?.[button.dataset.systemMode ?? "type"] ?? "automatic") === button.dataset.modeValue;
      button.setAttribute("aria-selected", String(selected));
    });
    ["type", "radius", "spacing"].forEach((system) => {
      const automatic = (state.modes?.[system] ?? "automatic") === "automatic";
      const automaticPanel = root.querySelector<HTMLElement>(`[data-system-auto="${system}"]`);
      const manualPanel = root.querySelector<HTMLElement>(`[data-system-manual="${system}"]`);
      if (automaticPanel) automaticPanel.hidden = !automatic;
      if (manualPanel) manualPanel.hidden = automatic;
    });
    root.querySelectorAll<HTMLElement>("[data-framework-accordion]").forEach((section) => {
      const open = section.dataset.frameworkAccordion === state.openAccordion;
      section.querySelector<HTMLButtonElement>("[data-accordion-trigger]")?.setAttribute("aria-expanded", String(open));
      const content = section.querySelector<HTMLElement>("[data-accordion-content]");
      if (content) content.hidden = !open;
    });
    elementUiState = state.elements ?? { selectedElement:null, treatmentRule:null };
    syncFontPickers();
    window.setTimeout(() => emitFrameworkEvent("framework-elements:apply-ui-state", elementUiState), 0);
  };
  const persistState = () => {
    try {
      const diff = serializeSettingsDiff(collectState(), defaultState);
      localStorage.removeItem(LEGACY_STORAGE_KEY);
      if (diff) localStorage.setItem(UI_DIFF_KEY, diff);
      else localStorage.removeItem(UI_DIFF_KEY);
    } catch { /* Storage may be unavailable. */ }
  };
  const openInitialColors = () => {
    root?.querySelectorAll<HTMLElement>("[data-framework-accordion]").forEach((section) => {
      const open = section.dataset.frameworkAccordion === "colors";
      section.querySelector<HTMLButtonElement>("[data-accordion-trigger]")?.setAttribute("aria-expanded", String(open));
      const content = section.querySelector<HTMLElement>("[data-accordion-content]");
      if (content) content.hidden = !open;
    });
  };
  const manualRange = (tokens: readonly { token:string; min:number }[]) => {
    const px = tokens.filter((token) => token.token !== "full").map((token) => token.min * 16);
    return `${Math.min(...px)}–${Math.max(...px)}`;
  };
  const setText = (selector: string, value: string) => { const node = root?.querySelector<HTMLElement>(selector); if (node) node.textContent = value; };
  const showConventionProblem = (inputSelector: string, errorSelector: string, hasCollision: boolean, message: string) => {
    const input = root?.querySelector<HTMLInputElement>(inputSelector);
    input?.setCustomValidity(hasCollision ? message : "");
    input?.setAttribute("aria-invalid", String(hasCollision));
    const error = root?.querySelector<HTMLElement>(errorSelector);
    if (error) error.hidden = !hasCollision;
  };

  const refreshSemanticOptions = (colors: GeneratedColor[]) => {
    const options=buildSemanticColorOptions(colors);
    const primaryBase=options.find((option)=>option.label.endsWith(" / Base"))?.reference ?? "oklch(0% 0 0)";
    const defaults: Record<string,string> = {
      primary:primaryBase,
      action:primaryBase,
      surface:options.find((option)=>option.label.endsWith(" / Lightest"))?.reference ?? "oklch(100% 0 0)",
      text:"oklch(0% 0 0)",
      border:options.find((option)=>option.label.endsWith(" / Light"))?.reference ?? primaryBase,
      focus:primaryBase,
    };
    const roles = Array.from(root?.querySelectorAll<HTMLSelectElement>("[data-semantic-role]") ?? []).map((select) => {
      const role=select.dataset.semanticRole ?? "primary";
      const requested=select.dataset.pendingValue || select.value || defaults[role];
      const selectedOption=select.selectedOptions[0];
      const requestedLabel=selectedOption?.textContent ?? undefined;
      const previousOption: SemanticColorOption | undefined = selectedOption ? {
        label:requestedLabel ?? "",
        reference:selectedOption.value,
        value:selectedOption.dataset.colorValue ?? selectedOption.value,
        colorId:selectedOption.dataset.colorId,
        shade:selectedOption.dataset.shade as SemanticShade | undefined,
      } : undefined;
      return {
        role,
        requestedReference: requested,
        requestedLabel,
        previousOption,
        apply: (refreshedOptions: readonly SemanticColorOption[], preserved: SemanticColorOption) => {
          select.replaceChildren(...refreshedOptions.map((item) => {
            const option=new Option(item.label,item.reference);
            option.dataset.colorValue=item.value;
            if(item.colorId)option.dataset.colorId=item.colorId;
            if(item.shade)option.dataset.shade=item.shade;
            return option;
          }));
          select.value=preserved.reference;
          const combobox=root?.querySelector<HTMLElement>(`[data-combobox-id="semantic-role-${role}"]`);
          emitElementEvent(combobox,"framework-combobox:update-options",{group:"Palette tokens",value:preserved.reference,options:refreshedOptions.map((item)=>({value:item.reference,label:item.label,meta:item.reference,preview:item.value,previewType:"color"}))});
          delete select.dataset.pendingValue;
        },
      };
    });
    refreshSemanticColorRoles({ colors, roles, defaults });
  };

  /** Normalize the form, derive the Primitive snapshot from settings state, render summaries, and publish it. */
  const publish = (deferCompilation = false) => {
    colorRows().forEach((row) => {
      const hexInput = row.querySelector<HTMLInputElement>("[data-color-hex]");
      const picker = row.querySelector<HTMLInputElement>("[data-color-picker]");
      const hex = normalizeHex(hexInput?.value ?? picker?.value ?? starterSettings.colors[0].hex);
      if (hexInput) hexInput.value = hex;
      if (picker) picker.value = hex;
    });
    const viewport = settingsViewport(collectState());
    const maxInput = root?.querySelector<HTMLInputElement>("[data-fluid-max-width]");
    if (maxInput) maxInput.value = String(viewport.maxPx);
    setText("[data-viewport-range-label]", `${viewport.minPx} → ${viewport.maxPx} px`);

    // Semantic selects follow palette renames before the state is read again.
    const palette = settingsPalette(collectState());
    refreshSemanticOptions(palette.colors.map((color, index) => ({ ...color, id: ensureColorId(colorRows()[index]) })));
    const state = collectState();
    const snapshot = primitiveSnapshotFromSettings(state);

    showConventionProblem("[data-color-convention]", "[data-color-convention-error]", palette.hasCollision, "Color naming convention conflicts with another generated token.");
    const semanticConvention = settingsSemanticConvention(state, palette.convention);
    showConventionProblem("[data-semantic-convention]", "[data-semantic-convention-error]", semanticConvention.hasCollision, "Semantic naming convention must differ from Colors.");
    setText("[data-semantic-summary]", `${semanticConvention.convention} · ${Object.keys(snapshot.semantics).length} roles`);
    const scaleNames=["Lightest","Lighter","Light","Base","Dark","Darker","Darkest"];
    colorRows().forEach((row, index) => {
      const scale = snapshot.colors[index]?.scale ?? [];
      row.querySelectorAll<HTMLElement>("[data-color-scale] span").forEach((item, step) => {
        item.style.setProperty("--color-step", scale[step]);
        item.title=`${scaleNames[step]}: ${scale[step]}`;
        item.setAttribute("aria-label",`${scaleNames[step]} ${scale[step]}`);
      });
      const remove = row.querySelector<HTMLButtonElement>("[data-remove-color]");
      if (remove) remove.disabled = snapshot.colors.length === 1;
    });
    const colorSummary = root?.querySelector<HTMLElement>("[data-color-summary]");
    if (colorSummary) {
      colorSummary.innerHTML = `<span>${palette.convention} ·</span>${snapshot.colors.slice(0, 6).map((color) => `<i style="--summary-color:${color.value}"></i>`).join("")}`;
      colorSummary.setAttribute("aria-label", snapshot.colors.map((color) => color.name).join(", "));
    }
    const pxRange = (system: "type" | "radius" | "spacing") => `${state.controls[`data-${system}-min`]}–${state.controls[`data-${system}-max`]}`;
    setText("[data-type-summary]", `${snapshot.type.family} · ${snapshot.type.mode === "manual" && snapshot.type.tokens ? manualRange(snapshot.type.tokens) : pxRange("type")} px`);
    setText("[data-radius-summary]", `${snapshot.radii.name} · ${snapshot.radii.mode === "manual" ? manualRange(snapshot.radii.tokens) : pxRange("radius")} px`);
    setText("[data-spacing-summary]", `${snapshot.spacing.name} · ${snapshot.spacing.mode === "manual" ? manualRange(snapshot.spacing.tokens) : pxRange("spacing")} px`);
    ["type", "radius", "spacing"].forEach((system) => setText(`[data-${system}-range-label]`, "Shared viewport"));
    emitFrameworkEvent("framework-preview:update", { ...snapshot, deferCompilation });
  };

  publish();
  const defaultState = starterSettings;
  onFrameworkEvent("framework-elements:state-change", (detail) => {
    const next = parseElementUiState(detail);
    if (!next) return;
    elementUiState = next;
    persistState();
  });
  const restored = (() => {
    try { return restoreSettingsState(defaultState, localStorage.getItem(UI_DIFF_KEY), localStorage.getItem(LEGACY_STORAGE_KEY)); }
    catch { return { kind:"defaults" } as const; }
  })();
  if (restored.kind === "defaults") openInitialColors();
  else applyState(restored.state);
  if (restored.kind === "legacy") persistState();
  // The Starter Defaults baseline is derived without touching the form.
  onFrameworkEvent("framework-primitives:request-baseline", () => {
    emitFrameworkEvent("framework-preview:update", { ...primitiveSnapshotFromSettings(starterSettings), baseline:true });
  });
  onFrameworkEvent("framework-export:request", () => publish());
  root?.addEventListener("settings-accordion:change", persistState);

  root?.querySelectorAll<HTMLButtonElement>("[data-system-mode]").forEach((button) => button.addEventListener("click", () => {
    const system = button.dataset.systemMode ?? "type";
    root.querySelectorAll<HTMLButtonElement>(`[data-system-mode="${system}"]`).forEach((item) => item.setAttribute("aria-selected", String(item === button)));
    const automatic = button.dataset.modeValue === "automatic";
    const automaticPanel = root.querySelector<HTMLElement>(`[data-system-auto="${system}"]`);
    const manualPanel = root.querySelector<HTMLElement>(`[data-system-manual="${system}"]`);
    if (automaticPanel) automaticPanel.hidden = !automatic;
    if (manualPanel) manualPanel.hidden = automatic;
    publish();
    persistState();
  }));

  onElementEvent(root,"framework-combobox:preview-options",(detail)=>{
    if(!detail||!fontPickers.some(({id})=>id===detail.id))return;
    loadFontPreviews(detail.requests);
  });

  onElementEvent(root,"framework-combobox:select",(detail)=>{
    if(!detail)return;
    const fontPicker = fontPickers.find(({ id }) => id === detail.id);
    if (fontPicker) {
      const control = root?.querySelector<HTMLInputElement>(`[${fontPicker.attribute}]`);
      if (control) control.value = detail.value;
      loadFontPreviews([{ family:detail.value, weights:fontPicker.previewWeights }]);
      publish();
      persistState();
      return;
    }
    if(!String(detail.id).startsWith("semantic-role-"))return;
    const role=String(detail.id).replace("semantic-role-","");
    const select=root?.querySelector<HTMLSelectElement>(`[data-semantic-role="${role}"]`);
    if(select){select.value=detail.value;publish();persistState();}
  });

  root?.addEventListener("input", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement || target instanceof HTMLSelectElement)) return;
    const row = target.closest<HTMLElement>("[data-color-row]");
    if (row && target instanceof HTMLInputElement) {
      const picker = row.querySelector<HTMLInputElement>("[data-color-picker]");
      const hex = row.querySelector<HTMLInputElement>("[data-color-hex]");
      if (target.matches("[data-color-picker]") && hex) hex.value = normalizeHex(target.value);
      if (target.matches("[data-color-hex]")) {
        const complete = /^#?[0-9a-f]{3}(?:[0-9a-f]{3})?$/i.test(target.value.trim());
        if (!complete) return;
        if (picker) picker.value = normalizeHex(target.value);
      }
      publish(true);
      persistState();
      return;
    }
    publish();
    persistState();
  });
  root?.addEventListener("change", () => {
    publish();
    persistState();
  });
  root?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const remove = target.closest<HTMLButtonElement>("[data-remove-color]");
    if (remove && colorRows().length > 1) { remove.closest("[data-color-row]")?.remove(); publish(); persistState(); }
  });
  root?.querySelector("[data-add-color]")?.addEventListener("click", () => {
    appendColorRow(`Color ${colorCount + 1}`, "#7C3AED");
    publish();
    persistState();
  });
  root?.querySelector("[data-framework-reset]")?.addEventListener("click", () => {
    try { localStorage.removeItem(LEGACY_STORAGE_KEY); localStorage.removeItem(UI_DIFF_KEY); } catch { /* Ignore unavailable storage. */ }
    emitFrameworkEvent("framework-site-theme:reset");
    emitFrameworkEvent("framework-elements:reset-framework");
    applyState(defaultState);
    publish();
    persistState();
  });
  loadGoogleFonts();
  window.setTimeout(() => publish(), 0);
</script>

<style is:global>
  .framework-viewport { display:grid; gap:6px; margin-bottom:4px; }
  .framework-viewport .framework-card__header { height:auto; padding:0 2px; border:0; }
