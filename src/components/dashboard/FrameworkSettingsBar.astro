  .framework-color-summary i + i { margin-left:-5px; }
  .framework-colors__list { display:grid; gap:8px; }
  .framework-button { display:flex; align-items:center; justify-content:center; gap:5px; height:30px; border:1px solid var(--line); border-radius:6px; background:white; font-size:10px; font-weight:700; }
  .framework-mode { display:grid; grid-template-columns:1fr 1fr; gap:2px; padding:2px; border-radius:5px; background:#edf0f5; }
  .framework-mode button { height:28px; border:0; border-radius:4px; background:transparent; color:var(--muted); }
  .framework-mode button[aria-selected="true"] { background:#172033; color:white; }
  .framework-card { display:grid; }
  .framework-font-field { padding:5px 0; }
  .framework-card[data-system-auto],.framework-semantic-fields { display:contents; }
  .framework-semantic-field { padding:3px 0; }
  [data-framework-accordion="semantics"] > [data-settings-accordion-content] > .framework-field { border-bottom:0; }
  .framework-card__header { display:flex; align-items:center; justify-content:space-between; min-height:28px; padding:0; border:0; }
  .framework-card__header span { color:var(--muted); font-size:9px; }
  .framework-field { display:grid; gap:5px; padding:7px 0; border-bottom:0; }
  .framework-field:last-child { border-bottom:0; }
  .framework-field small { display:block; margin-top:2px; color:#9198a3; font-size:9px; font-weight:500; }
  .framework-field--inline { grid-template-columns:1fr auto; align-items:center; }
  .framework-field-pair { display:grid; grid-template-columns:1fr 1fr; border-bottom:0; }
  .framework-field-pair .framework-field { border-bottom:0; }
  .framework-field-pair .framework-field:first-child { border-right:1px solid var(--line); }
  .framework-control { position:relative; display:flex; align-items:center; height:30px; border:1px solid #ccd3dd; border-radius:5px; background:#fbfcfd; overflow:hidden; }
  .framework-control:focus-within { border-color:var(--accent); box-shadow:0 0 0 2px rgb(37 99 235 / .1); }
  .framework-control input,.framework-control select { width:100%; height:100%; border:0; outline:0; padding:0 8px; background:transparent; }
  .framework-control select { appearance:none; padding-right:25px; font-size:11px; }
  .framework-control--select svg { position:absolute; right:7px; pointer-events:none; color:#808895; }
  .framework-control--unit input { min-width:0; padding-right:2px; }
  .framework-control--unit i,.framework-manual i { padding-right:6px; color:#949ba6; font-size:9px; font-style:normal; }
  .framework-control--short { width:66px; }
  .framework-switch { appearance:none; width:28px; height:16px; margin:0; border-radius:999px; background:#cbd1db; }
  .framework-switch::before { content:""; display:block; width:12px; height:12px; margin:2px; border-radius:50%; background:white; box-shadow:0 1px 2px rgb(0 0 0/.2); }
  .framework-switch:checked { background:var(--accent); }
  .framework-switch:checked::before { transform:translateX(12px); }
  .framework-manual { display:grid; gap:4px; }
  .framework-manual > p { margin:0 0 4px; color:var(--muted); font-size:10px; }
  .framework-manual label { display:grid; grid-template-columns:34px 1fr auto; align-items:center; height:30px; border:1px solid var(--line); border-radius:5px; padding-left:8px; background:white; }
  .framework-manual input { min-width:0; height:100%; border:0; outline:0; }
  [hidden] { display:none !important; }
</style>
