---
import { Search } from "@lucide/astro";
import Kbd from "../ui/Kbd.astro";
import { siteSearchEntries } from "../../shared/site-search-index.ts";
---

<dialog class="site-search" aria-label="Search techies.tools" data-site-search>
  <div class="site-search__bar">
    <Search class="site-search__icon" aria-hidden="true" size={16} stroke-width={2} />
    <input
      class="site-search__input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="site-search-results"
      aria-autocomplete="list"
      aria-label="Search apps and pages"
      placeholder="Search apps and pages..."
      autocomplete="off"
      spellcheck="false"
      data-site-search-input
    />
    <Kbd keys="Esc" />
  </div>
  <ul class="site-search__results" id="site-search-results" role="listbox" aria-label="Results" data-site-search-results></ul>
  <p class="site-search__empty" hidden data-site-search-empty></p>
  <p class="sr-only" role="status" data-site-search-status></p>
  <p class="site-search__hint" aria-hidden="true"><span><Kbd keys="↑" /><Kbd keys="↓" /> to move</span><span><Kbd keys="Enter" /> to open</span><span><Kbd keys="Esc" /> to close</span></p>
</dialog>
<script type="application/json" id="site-search-index" set:html={JSON.stringify(siteSearchEntries()).replace(/</g, "\\u003c")} />

<script>
  import { searchSite, type SiteSearchEntry } from "../../shared/site-search.ts";

  const dialog = document.querySelector<HTMLDialogElement>("[data-site-search]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-site-search-input]");
  const list = dialog?.querySelector<HTMLUListElement>("[data-site-search-results]");
  const empty = dialog?.querySelector<HTMLElement>("[data-site-search-empty]");
  const status = dialog?.querySelector<HTMLElement>("[data-site-search-status]");
  const entries: SiteSearchEntry[] = JSON.parse(document.querySelector("#site-search-index")?.textContent ?? "[]");
  let options: HTMLAnchorElement[] = [];
  let active = -1;

  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    document.querySelectorAll("[data-site-search-shortcut] .kbd").forEach((kbd) => (kbd.textContent = "⌘ K"));
  }

  const setActive = (index: number) => {
    options[active]?.setAttribute("aria-selected", "false");
    active = options.length ? (index + options.length) % options.length : -1;
    const option = options[active];
    option?.setAttribute("aria-selected", "true");
    option?.scrollIntoView({ block: "nearest" });
    if (option) input?.setAttribute("aria-activedescendant", option.id);
    else input?.removeAttribute("aria-activedescendant");
  };

  const render = () => {
    if (!input || !list || !empty || !status) return;
    const results = searchSite(entries, input.value);
    list.replaceChildren(...results.map((entry, index) => {
      const item = document.createElement("li");
      item.setAttribute("role", "presentation");
      const link = document.createElement("a");
      link.className = "site-search__option";
      link.id = `site-search-option-${index}`;
      link.setAttribute("role", "option");
      link.href = entry.href;
      link.tabIndex = -1;
      link.setAttribute("aria-selected", "false");
      if (entry.external) {
        link.target = "_blank";
        link.rel = "noreferrer";
        link.dataset.external = "";
      }
      const title = document.createElement("span");
      title.className = "site-search__title";
      title.textContent = entry.title;
      const description = document.createElement("span");
      description.className = "site-search__description";
      description.textContent = entry.description;
      const group = document.createElement("span");
      group.className = "site-search__group";
      group.textContent = entry.group;
      link.append(title, description, group);
      link.addEventListener("pointermove", () => { if (active !== index) setActive(index); });
      // Close first, so links to a section of the current page and new tabs leave no dialog behind.
      link.addEventListener("click", () => dialog?.close());
      item.append(link);
      return item;
    }));
    options = [...list.querySelectorAll<HTMLAnchorElement>("[role=option]")];
    active = -1;
    setActive(0);
    empty.hidden = results.length > 0;
    empty.textContent = results.length ? "" : `No apps or pages match “${input.value.trim()}”.`;
    status.textContent = results.length === 1 ? "1 result" : `${results.length} results`;
  };

  const open = () => {
    if (!dialog || !input) return;
    if (!dialog.open) {
      input.value = "";
      render();
      dialog.showModal();
    }
    input.focus();
    input.select();
  };

  document.querySelectorAll("[data-site-search-open]").forEach((button) => button.addEventListener("click", open));

  window.addEventListener("keydown", (event) => {
    if (event.key.toLowerCase() !== "k" || !(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey) return;
    event.preventDefault();
    open();
  });

  input?.addEventListener("input", render);
  input?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      setActive(active + (event.key === "ArrowDown" ? 1 : -1));
    } else if (event.key === "Enter" && options[active]) {
      event.preventDefault();
      options[active].click();
    }
  });

  // A click on the dimmed backdrop lands on the dialog itself and closes it.
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
</script>

<style>
  .site-search {
    inline-size: min(36rem, calc(100% - 2rem));
    max-block-size: min(34rem, calc(100dvh - 4rem));
    margin: 12dvh auto auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 0;
    background: var(--card);
    color: var(--foreground);
    box-shadow: 0 24px 64px -24px color-mix(in oklch, var(--semantic-text) 40%, transparent);
  }

  .site-search[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    opacity: 1;
    transform: none;
    transition: opacity 140ms ease, transform 160ms ease;
  }

  @starting-style {
    .site-search[open] {
      opacity: 0;
      transform: translateY(-0.375rem) scale(0.985);
    }
  }

  .site-search::backdrop {
    background: color-mix(in oklch, var(--semantic-text) 28%, transparent);
  }

  .site-search__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.625rem;
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 1rem;
  }

  .site-search__bar :global(.site-search__icon) {
    color: var(--muted-foreground);
  }

  .site-search__input {
    min-inline-size: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: 1rem;
  }

  .site-search__input::placeholder {
    color: var(--muted-foreground);
    opacity: 1;
  }

  .site-search__results {
    display: grid;
    align-content: start;
    gap: 0.125rem;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
    list-style: none;
  }

  .site-search__results :global(.site-search__option) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.125rem 0.75rem;
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    color: var(--foreground);
    text-decoration: none;
  }

  .site-search__results :global(.site-search__option[aria-selected="true"]) {
    background: var(--accent);
  }

  .site-search__results :global(.site-search__title) {
    font-size: 0.875rem;
    font-weight: 650;
  }

  .site-search__results :global(.site-search__option[data-external] .site-search__title)::after {
    content: " ↗";
    color: var(--muted-foreground);
  }

  .site-search__results :global(.site-search__description) {
    grid-column: 1;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 0.78rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .site-search__results :global(.site-search__group) {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .site-search__empty {
    padding: 1.5rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    text-align: center;
  }

  .site-search__hint {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    border-top: 1px solid var(--border);
    padding: 0.5rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
  }

  .site-search__hint span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-search[open] {
      transition: none;
    }
  }
</style>
