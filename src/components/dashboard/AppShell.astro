---
import AppSidebar from "./AppSidebar.astro";

interface Props {
  previewScope: string;
}

const { previewScope } = Astro.props;
---

<div class="dashboard-shell">
  <div class="dashboard-shell__rail">
    <AppSidebar />
    <div class="dashboard-shell__settings">
      <slot name="settings" />
    </div>
  </div>
  <main
    class="dashboard-shell__main"
    data-preview-scope={previewScope}
    data-framework-preview={previewScope === "framework" ? "" : undefined}
  >
    <slot />
  </main>
</div>

<script>
  import "../../settings/controller/browser.ts";
</script>

<style>
  .dashboard-shell {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    min-block-size: 100vh;
    max-block-size: 100vh;
    overflow: hidden;
    background: var(--background);
  }

  .dashboard-shell__rail {
    display: grid;
    grid-template-columns: auto auto;
    min-block-size: 0;
    box-shadow: 1px 0 0 var(--sidebar-border);
  }

  .dashboard-shell__settings {
    min-block-size: 0;
    block-size: 100vh;
    overflow: hidden;
    background: #fafbfc;
  }

  .dashboard-shell__main {
    min-inline-size: 0;
    min-block-size: 0;
    overflow: hidden;
    padding: 0;
  }

  @media (max-width: 720px) {
    .dashboard-shell {
      grid-template-columns: 1fr;
      max-block-size: none;
      overflow: visible;
    }

    .dashboard-shell__rail {
      max-block-size: none;
    }

    .dashboard-shell__main {
      block-size: 100dvh;
      contain: paint;
      max-block-size: none;
    }
  }
</style>
