---
import * as Icons from "@lucide/astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import AppSidebar from "../dashboard/AppSidebar.astro";
import FrameworkSiteThemeBootstrap from "../dashboard/FrameworkSiteThemeBootstrap.astro";
import GitHubStarLink from "./GitHubStarLink.astro";
import { githubOrganization, showcaseAddresses, showcaseProjects, showcaseRepositories, showcaseTools } from "../../showcase/projects.ts";
import "../../styles/global.css";

const { ArrowRight, ArrowUpRight, Check, ShieldCheck } = Icons;
const icon = (name: keyof typeof Icons) => Icons[name] as AstroComponentFactory;
const frameworkPath = showcaseTools[0].links[0].href;
const sections = [
  { id: "why", label: "Why it exists" },
  { id: "tools", label: "Tools on this site" },
  { id: "projects", label: "More projects" },
  { id: "security", label: "Security and privacy" },
  { id: "open-source", label: "Free and on GitHub" },
  { id: "addresses", label: "All addresses" },
];
const problems = [
  { name: "the Framework", problem: "AI tools and templates make every website look the same.", fix: "The Framework records your design choices once and hands them to any website or AI assistant as plain files." },
  ...showcaseProjects.slice(0, 2).map(({ name, problem, fix }) => ({ problem, fix, name })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Free tools by Techies: a design Framework, interface patterns, a glass card maker, a visual website editor, a WordPress test bench, and a camera overlay. All code is on GitHub." />
    <link rel="canonical" href="https://techies.tools/" />
    <title>techies.tools — free tools for building websites</title>
    <FrameworkSiteThemeBootstrap />
  </head>
  <body>
    <div class="home-shell">
      <AppSidebar />
      <main class="home">
        <header class="home__hero">
          <p class="home__eyebrow">Free · Code on GitHub · Privacy first</p>
          <h1>Tools we built to fix our own problems.</h1>
          <p class="home__lead">techies.tools is the home of everything Techies has made so far: design tools that run in your browser, a visual editor for plain websites, a WordPress test bench, and a camera overlay for recording. Use them for free, and read their code on GitHub.</p>
          <div class="home__actions">
            <a class="home__button home__button--primary" href="#tools">Explore the tools <ArrowRight size={15} aria-hidden="true" /></a>
            <a class="home__button" href={githubOrganization} target="_blank" rel="noreferrer">See all code on GitHub <ArrowUpRight size={15} aria-hidden="true" /></a>
          </div>
          <nav class="home__contents" aria-label="On this page">
            {sections.map(({ id, label }) => <a href={`#${id}`}>{label}</a>)}
          </nav>
        </header>

        <section class="home__section" id="why" aria-labelledby="why-title">
          <header class="home__section-header">
            <p class="home__eyebrow">Why it exists</p>
            <h2 id="why-title">The problems we kept running into</h2>
            <p>Each project started as a fix for something that got in our way while building websites and videos.</p>
          </header>
          <ol class="home__problems">
            {problems.map(({ problem, fix, name }) => (
              <li>
                <p class="home__problem"><strong>The problem</strong>{" "}{problem}</p>
                <p class="home__fix"><strong>How {name} fixes it</strong>{" "}{fix}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="home__section" id="tools" aria-labelledby="tools-title">
          <header class="home__section-header">
            <p class="home__eyebrow">On techies.tools</p>
            <h2 id="tools-title">Tools on this site</h2>
            <p>Open any of them here or from the Main menu. Your choices are saved in your browser and travel between the tools.</p>
          </header>
          <div class="home__tools">
            {showcaseTools.map((tool) => {
              const Icon = icon(tool.icon);
              return (
                <article class="home__card">
                  <span class="home__card-icon" aria-hidden="true"><Icon size={18} /></span>
                  <h3>{tool.name}</h3>
                  <p>{tool.summary}</p>
                  <ul class="home__links">
                    {tool.links.map((link) => <li><a href={link.href}>{link.label} <ArrowRight size={13} aria-hidden="true" /></a></li>)}
                  </ul>
                </article>
              );
            })}
          </div>
        </section>

        <section class="home__section" id="projects" aria-labelledby="projects-title">
          <header class="home__section-header">
            <p class="home__eyebrow">More from Techies</p>
            <h2 id="projects-title">More projects</h2>
            <p>Each one lives at its own address and works on its own.</p>
          </header>
          <div class="home__projects">
            {showcaseProjects.map((project) => {
              const Icon = icon(project.icon);
              return (
                <article class="home__project" id={project.id}>
                  <header>
                    <span class="home__card-icon" aria-hidden="true"><Icon size={18} /></span>
                    <div>
                      <p class="home__kind">{project.kind}</p>
                      <h3>{project.name}</h3>
                    </div>
                  </header>
                  <p class="home__summary">{project.summary}</p>
                  <dl class="home__story">
                    <div><dt>The problem</dt><dd>{project.problem}</dd></div>
                    <div><dt>How it fixes it</dt><dd>{project.fix}</dd></div>
                  </dl>
                  <ul class="home__features">
                    {project.features.map((feature) => <li><Check size={14} aria-hidden="true" />{feature}</li>)}
                  </ul>
                  <div class="home__project-actions">
                    <a class="home__button home__button--primary" href={project.primary.href} target="_blank" rel="noreferrer">{project.primary.label} <ArrowUpRight size={15} aria-hidden="true" /></a>
                    {project.repository && <GitHubStarLink repository={project.repository} name={project.name} />}
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <section class="home__section" id="security" aria-labelledby="security-title">
          <header class="home__section-header">
            <p class="home__eyebrow">Security and privacy</p>
            <h2 id="security-title">Your work stays with you</h2>
            <p>We do not run ads, analytics, or tracking cookies. Here is where your data lives in each project.</p>
          </header>
          <div class="home__security">
            <article class="home__card">
              <span class="home__card-icon" aria-hidden="true"><ShieldCheck size={18} /></span>
              <h3>techies.tools</h3>
              <ul class="home__features">
                <li><Check size={14} aria-hidden="true" />No account. Your Framework, patterns, and glass cards are saved only in your browser.</li>
                <li><Check size={14} aria-hidden="true" />We keep no database. Exports are files you download and own.</li>
                <li><Check size={14} aria-hidden="true" />Our host, Cloudflare, keeps short-lived request logs so we can fix errors.</li>
                <li><Check size={14} aria-hidden="true" />Fonts you pick load from Google Fonts. This page asks GitHub for public star counts.</li>
              </ul>
            </article>
            {showcaseProjects.map((project) => (
              <article class="home__card">
                <span class="home__card-icon" aria-hidden="true"><ShieldCheck size={18} /></span>
                <h3>{project.name}</h3>
                <ul class="home__features">
                  {project.privacy.map((item) => <li><Check size={14} aria-hidden="true" />{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="home__section" id="open-source" aria-labelledby="open-source-title">
          <header class="home__section-header">
            <p class="home__eyebrow">Free and on GitHub</p>
            <h2 id="open-source-title">Free to use, open to read</h2>
            <p>Every tool here is free. The code for each one is public, except the Astro Live Builder experiment, so you can check what it does, report a problem, or run your own copy.</p>
          </header>
          <ul class="home__repositories">
            {showcaseRepositories.map(({ name, repository, summary }) => (
              <li>
                <div><strong>{name}</strong><span>{summary}</span></div>
                <GitHubStarLink repository={repository} name={name} />
              </li>
            ))}
          </ul>
        </section>

        <section class="home__section" id="addresses" aria-labelledby="addresses-title">
          <header class="home__section-header">
            <p class="home__eyebrow">Where to find it</p>
            <h2 id="addresses-title">All addresses</h2>
            <p>Everything Techies runs on techies.tools. Test versions show upcoming changes before they go live and may be unstable.</p>
          </header>
          <ul class="home__addresses">
            {showcaseAddresses.map(({ host, href, purpose, test }) => (
              <li>
                <a href={href} target="_blank" rel="noreferrer">{host}</a>
                <span>{purpose}</span>
                {test && <em>Test version</em>}
              </li>
            ))}
          </ul>
        </section>

        <footer class="home__footer">
          <div><strong>Start with the Framework</strong><span>Choose your colors, type, space, and elements in one live preview.</span></div>
          <a href={frameworkPath}>Open Framework <ArrowUpRight size={14} aria-hidden="true" /></a>
        </footer>
      </main>
    </div>

    <script>
      // Show public GitHub star counts when GitHub answers; links work without them.
      const cacheKey = "techies-tools:github-stars:v2";
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-github-api]")];
      const repositories = [...new Set(links.map((link) => link.dataset.githubApi!))];
      let cache: Record<string, number> = {};
      try { cache = JSON.parse(sessionStorage.getItem(cacheKey) ?? "{}") ?? {}; } catch { cache = {}; }

      const show = (repository: string, stars: number) => {
        for (const link of links.filter((item) => item.dataset.githubApi === repository)) {
          const count = link.querySelector<HTMLElement>(".github-star__count");
          const value = link.querySelector<HTMLElement>("[data-github-star-count]");
          if (!count || !value || stars < 1) continue;
          value.textContent = stars.toLocaleString();
          count.hidden = false;
          link.setAttribute("aria-label", `${link.dataset.githubName} on GitHub, ${stars.toLocaleString()} stars`);
        }
      };

      for (const repository of repositories) {
        if (Number.isSafeInteger(cache[repository])) {
          show(repository, cache[repository]);
          continue;
        }
        fetch(repository, { headers: { Accept: "application/vnd.github+json" } })
          .then((response) => (response.ok ? response.json() : null))
          .then((payload) => {
            const stars = payload?.stargazers_count;
            if (!Number.isSafeInteger(stars) || stars < 0) return;
            cache[repository] = stars;
            try { sessionStorage.setItem(cacheKey, JSON.stringify(cache)); } catch {}
            show(repository, stars);
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>

<style>
  .home-shell { display:grid; grid-template-columns:auto minmax(0,1fr); block-size:100vh; overflow:hidden; background:var(--card); }
  .home { container:home / inline-size; min-inline-size:0; overflow:auto; background:linear-gradient(180deg,var(--accent) 0,var(--card) 34rem); scroll-behavior:smooth; }
  @media (prefers-reduced-motion:reduce) { .home { scroll-behavior:auto; } }
  .home__hero,.home__section,.home__footer { max-inline-size:72rem; margin-inline:auto; padding-inline:4rem; }
  .home__hero { padding-block:5.5rem 3.5rem; }
  .home__eyebrow { margin:0 0 1rem; color:var(--semantic-action); font-size:.75rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .home h1 { max-inline-size:15ch; margin:0; color:var(--semantic-text); font-family:var(--font-heading); font-size:clamp(2.75rem,6vw,5.25rem); font-weight:760; letter-spacing:-.06em; line-height:.95; text-wrap:balance; }
  .home__lead { max-inline-size:44rem; margin:1.5rem 0 0; color:var(--muted-foreground); font-size:1.125rem; line-height:1.65; }
  .home__actions,.home__project-actions { display:flex; flex-wrap:wrap; gap:.75rem; }
  .home__actions { margin-top:2rem; }
  .home__button { display:inline-flex; align-items:center; gap:.45rem; min-block-size:2.75rem; border:1px solid var(--border); border-radius:var(--radius-full); padding:.65rem 1.1rem; background:var(--card); color:var(--semantic-text); font-size:.85rem; font-weight:800; text-decoration:none; }
  .home__button--primary { border-color:var(--semantic-action); background:var(--semantic-action); color:var(--semantic-surface); }
  .home__button:hover { filter:brightness(.96); }
  .home a:focus-visible { outline:2px solid var(--semantic-focus); outline-offset:2px; }
  .home__contents { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:3rem; }
  .home__contents a { border-radius:var(--radius-full); padding:.4rem .8rem; background:var(--card); box-shadow:0 0 0 1px var(--border); color:var(--muted-foreground); font-size:.78rem; font-weight:700; text-decoration:none; }
  .home__contents a:hover { color:var(--semantic-text); }
  .home__section { padding-block:3.5rem; scroll-margin-top:1rem; }
  .home__section-header { max-inline-size:44rem; margin-bottom:2rem; }
  .home h2 { margin:0; color:var(--semantic-text); font-family:var(--font-heading); font-size:clamp(1.75rem,3vw,2.4rem); letter-spacing:-.04em; line-height:1.1; }
  .home__section-header>p:last-child { margin:.75rem 0 0; color:var(--muted-foreground); font-size:1rem; line-height:1.6; }
  .home h3 { margin:0; color:var(--semantic-text); font-size:1.05rem; letter-spacing:-.01em; }
  .home__problems { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin:0; padding:0; list-style:none; }
  .home__problems li { display:grid; align-content:start; gap:1rem; border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem; background:var(--card); }
  .home__problems p { display:grid; gap:.35rem; margin:0; color:var(--muted-foreground); font-size:.9rem; line-height:1.55; }
  .home__problems strong,.home__story dt { color:var(--semantic-text); font-size:.7rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .home__fix strong { color:var(--semantic-action); }
  .home__tools { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .home__security { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,16rem),1fr)); gap:1rem; }
  .home__card,.home__project { display:grid; align-content:start; gap:.75rem; border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem; background:var(--card); }
  .home__card>p,.home__summary { margin:0; color:var(--muted-foreground); font-size:.88rem; line-height:1.6; }
  .home__card-icon { display:grid; place-items:center; inline-size:2.5rem; block-size:2.5rem; border-radius:var(--radius-l); background:var(--accent); color:var(--semantic-action); }
  .home__links { display:grid; gap:.35rem; margin:.25rem 0 0; padding:0; list-style:none; }
  .home__links a { display:inline-flex; align-items:center; gap:.3rem; color:var(--semantic-action); font-size:.85rem; font-weight:750; text-decoration:none; }
  .home__links a:hover { text-decoration:underline; }
  .home__projects { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .home__project { gap:1rem; padding:1.75rem; scroll-margin-top:1rem; }
  .home__project>header { display:flex; align-items:center; gap:.85rem; }
  .home__kind { margin:0 0 .15rem; color:var(--muted-foreground); font-size:.7rem; font-weight:750; letter-spacing:.06em; text-transform:uppercase; }
  .home__project h3 { font-size:1.35rem; letter-spacing:-.03em; }
  .home__summary { color:var(--semantic-text); font-size:.95rem; }
  .home__story { display:grid; gap:.75rem; margin:0; border-radius:var(--radius-l); padding:1rem; background:var(--muted); }
  .home__story div { display:grid; gap:.25rem; }
  .home__story dd { margin:0; color:var(--muted-foreground); font-size:.85rem; line-height:1.55; }
  .home__features { display:grid; gap:.55rem; margin:0; padding:0; list-style:none; }
  .home__features li { display:grid; grid-template-columns:auto minmax(0,1fr); gap:.55rem; color:var(--muted-foreground); font-size:.85rem; line-height:1.5; }
  .home__features :global(svg) { margin-top:.2rem; color:var(--semantic-action); }
  .home__project-actions { margin-top:auto; padding-top:.25rem; }
  .home__repositories,.home__addresses { display:grid; margin:0; border:1px solid var(--border); border-radius:var(--radius-xl); padding:0; background:var(--card); list-style:none; }
  .home__repositories li,.home__addresses li { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem 1rem; padding:1rem 1.25rem; }
  .home__repositories li+li,.home__addresses li+li { border-top:1px solid var(--border); }
  .home__repositories div { display:grid; flex:1 1 14rem; gap:.15rem; }
  .home__repositories strong { color:var(--semantic-text); font-size:.95rem; }
  .home__repositories span,.home__addresses span { color:var(--muted-foreground); font-size:.85rem; line-height:1.5; }
  .home__addresses a { min-inline-size:15rem; color:var(--semantic-action); font-family:var(--font-code); font-size:.85rem; font-weight:600; text-decoration:none; }
  .home__addresses a:hover { text-decoration:underline; }
  .home__addresses span { flex:1 1 16rem; }
  .home__addresses em { border-radius:var(--radius-full); padding:.2rem .55rem; background:var(--accent); color:var(--semantic-primary); font-size:.65rem; font-style:normal; font-weight:800; text-transform:uppercase; }
  .home__footer { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem 1.5rem; box-sizing:border-box; max-inline-size:calc(72rem - 8rem); margin:2rem auto 5rem; border-radius:var(--radius-full); padding:1.25rem 1.4rem 1.25rem 2rem; background:var(--semantic-action); color:var(--semantic-surface); }
  .home__footer div { display:grid; gap:.3rem; }
  .home__footer strong { font-size:1.05rem; }
  .home__footer span { color:color-mix(in oklch,var(--semantic-surface) 78%,transparent); font-size:.85rem; line-height:1.5; }
  .home__footer a { display:flex; align-items:center; gap:.4rem; min-block-size:2.75rem; border-radius:var(--radius-full); padding:.65rem 1.1rem; background:var(--semantic-surface); color:var(--semantic-primary); font-size:.85rem; font-weight:800; text-decoration:none; white-space:nowrap; }
  @container home (max-width:60rem) { .home__problems,.home__projects { grid-template-columns:1fr; } }
  @container home (max-width:52rem) { .home__hero,.home__section { padding-inline:2rem; } .home__footer { max-inline-size:none; margin-inline:2rem; } }
  @container home (max-width:40rem) { .home__tools { grid-template-columns:1fr; } .home__hero { padding-block:3.5rem 2.5rem; } .home__hero,.home__section { padding-inline:1.25rem; } .home__footer { margin-inline:1.25rem; border-radius:1.25rem; } .home__addresses a { min-inline-size:0; } }
  @media (max-width:720px) { .home-shell { grid-template-columns:1fr; align-content:start; overflow:auto; } .home { overflow:visible; } }
</style>
