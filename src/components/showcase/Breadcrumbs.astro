---
interface Props {
  /** Trail from Home; the last item is the current page and has no link. */
  items: readonly { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map(({ label, href }) => <li>{href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>)}
  </ol>
</nav>

<style>
  .breadcrumbs { margin-bottom:clamp(2rem,5cqi,3.5rem); color:var(--muted-foreground); font-size:.82rem; }
  .breadcrumbs ol { display:flex; flex-wrap:wrap; gap:.5rem; margin:0; padding:0; list-style:none; }
  .breadcrumbs li + li::before { content:"/"; margin-inline-end:.5rem; }
  .breadcrumbs a { color:inherit; text-decoration:none; }
  .breadcrumbs a:hover { color:var(--semantic-text); text-decoration:underline; }
  .breadcrumbs [aria-current] { color:var(--semantic-text); font-weight:650; }
</style>
