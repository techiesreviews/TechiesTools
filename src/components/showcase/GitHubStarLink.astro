---
import { Star } from "@lucide/astro";
import { githubRepositoryApiUrl, githubRepositoryUrl } from "../../showcase/projects.ts";

interface Props {
  repository: string;
  name: string;
}

const { repository, name } = Astro.props;
---

<a class="github-star" href={githubRepositoryUrl(repository)} target="_blank" rel="noreferrer" aria-label={`${name} on GitHub`} data-github-api={githubRepositoryApiUrl(repository)} data-github-name={name}>
  <svg class="github-star__mark" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
  <span>GitHub</span>
  <span class="github-star__count" hidden><Star size={12} aria-hidden="true" /><span data-github-star-count></span></span>
</a>

<style>
  .github-star { display:inline-flex; align-items:center; gap:.45rem; min-block-size:2.5rem; border:1px solid var(--border); border-radius:var(--radius-full); padding:.5rem .85rem; background:var(--card); color:var(--semantic-text); font-size:.8rem; font-weight:750; text-decoration:none; white-space:nowrap; }
  .github-star:hover { border-color:var(--semantic-border); background:var(--accent); }
  .github-star:focus-visible { outline:2px solid var(--semantic-focus); outline-offset:2px; }
  .github-star__mark { inline-size:1rem; block-size:1rem; }
  .github-star__count { display:inline-flex; align-items:center; gap:.25rem; border-inline-start:1px solid var(--border); padding-inline-start:.5rem; color:var(--muted-foreground); font-variant-numeric:tabular-nums; }
  .github-star__count[hidden] { display:none; }
</style>
