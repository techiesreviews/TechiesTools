  .guided-preview__feature figure i:nth-child(2) { background: color-mix(in oklch, var(--preview-action) 58%, white); transform: translateY(-8%) rotate(5deg); }
  .guided-preview__feature figure i:nth-child(3) { background: var(--preview-surface); transform: translateY(7%) rotate(-2deg); }
