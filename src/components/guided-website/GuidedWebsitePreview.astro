  .guided-preview--composition.guided-preview--editorial .guided-preview__heading { max-inline-size: 11ch; font-size: clamp(1.9rem, 11cqi, 5.8rem); font-weight: 820; line-height: 0.77; text-transform: uppercase; }
  .guided-preview--composition.guided-preview--editorial .guided-preview__hero-note { align-self: stretch; justify-content: end; padding: 8% 0 0 14%; border-inline-start: 1px solid var(--preview-border); }
