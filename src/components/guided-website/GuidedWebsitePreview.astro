  .guided-preview--surface.guided-preview--layered .guided-preview__service { background: linear-gradient(145deg, color-mix(in srgb, var(--preview-action) 12%, var(--preview-surface)), color-mix(in srgb, var(--preview-action) 25%, var(--preview-surface))); border-color: color-mix(in srgb, var(--preview-action) 28%, var(--preview-border)); box-shadow: 0 0.85rem 1.8rem color-mix(in srgb, var(--preview-action) 15%, transparent); }
