---
interface Props {
  mode: "composition" | "density" | "surface" | "voice" | "review" | "baseline";
  value?: string;
  decorative?: boolean;
}

const { mode, value = "framework", decorative = true } = Astro.props;
const classes = ["guided-preview", `guided-preview--${mode}`, `guided-preview--${value}`];
---

<article class:list={classes} aria-hidden={decorative ? "true" : undefined} data-guided-page-preview>
  <nav class="guided-preview__nav">
    <strong data-guided-project-output="organization" data-guided-fallback="Northstar">Northstar</strong>
    <div><span>Work</span><span>Method</span><span>About</span></div>
    <span class="guided-preview__nav-action" data-guided-project-output="primaryAction" data-guided-fallback="Start a project">Start a project</span>
  </nav>

  <section class="guided-preview__hero">
    <div class="guided-preview__hero-copy">
      <span class="guided-preview__kicker">A focused first draft</span>
      <h2 class="guided-preview__heading guided-preview__heading--direct">Make complex ideas clear.</h2>
      <h2 class="guided-preview__heading guided-preview__heading--expressive">Big idea? Good. Make it impossible to ignore.</h2>
      <p class="guided-preview__lead guided-preview__lead--direct" data-guided-project-output="offer" data-guided-fallback="Strategy and design for teams building what comes next.">Strategy and design for teams building what comes next.</p>
      <p class="guided-preview__lead guided-preview__lead--expressive"><strong data-guided-project-output="offer" data-guided-fallback="Strategy and design for teams building what comes next.">Strategy and design for teams building what comes next.</strong><span>Built to stand out, not blend in.</span></p>
      <div class="guided-preview__actions">
        <span data-guided-project-output="primaryAction" data-guided-fallback="View selected work">View selected work</span>
        <small>How we work →</small>
      </div>
    </div>
    <aside class="guided-preview__hero-note">
      <span>For</span>
      <strong data-guided-project-output="audience" data-guided-fallback="Thoughtful technology teams">Thoughtful technology teams</strong>
      <i></i>
      <small>Project audience</small>
    </aside>
    <div class="guided-preview__artifact" aria-hidden="true">
      <header><i></i><i></i><i></i><span>Working preview</span></header>
      <aside><i></i><i></i><i></i><i></i></aside>
      <div><span></span><strong></strong><span></span><span></span><small></small></div>
    </div>
  </section>

  <section class="guided-preview__proof">
    <span>Proof to add</span><strong>Evidence 01</strong><strong>Evidence 02</strong><strong>Evidence 03</strong>
  </section>

  <section class="guided-preview__services">
    <div class="guided-preview__service"><i>01</i><strong>What we do</strong><p data-guided-project-output="offer" data-guided-fallback="Your primary offer">Your primary offer</p><small>Offer overview ↗</small></div>
    <div class="guided-preview__service"><i>02</i><strong>Who it helps</strong><p data-guided-project-output="audience" data-guided-fallback="Your primary audience">Your primary audience</p><small>Audience outcome ↗</small></div>
    <div class="guided-preview__service"><i>03</i><strong>Next step</strong><p data-guided-project-output="primaryAction" data-guided-fallback="Your primary action">Your primary action</p><small>Action details ↗</small></div>
  </section>

  <section class="guided-preview__feature">
    <div><span>Evidence placeholder</span><strong>Verified case study</strong><small>Add real proof before publishing</small></div>
    <figure><i></i><i></i><i></i><figcaption>Reserved for a verified project outcome.</figcaption></figure>
  </section>
</article>

<style>
  .guided-preview {
    --preview-text: var(--semantic-text, var(--foreground));
    --preview-surface: var(--semantic-surface, var(--background));
    --preview-action: var(--semantic-action, var(--primary));
    --preview-action-text: var(--primary-foreground);
    --preview-border: var(--semantic-border, var(--border));
    --preview-radius: var(--radius-m, var(--radius-md));
    --preview-space: var(--space-m, var(--space-4));
    overflow: hidden;
    min-inline-size: 0;
    color: var(--preview-text);
    background: var(--preview-surface);
    border: 1px solid var(--preview-border);
    border-radius: min(var(--preview-radius), 0.75rem);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--preview-text) 10%, transparent);
    font-family: var(--text-body-family, var(--font-sans));
    container-type: inline-size;
  }

  .guided-preview__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: 3.25rem;
    padding-inline: 5%;
    border-block-end: 1px solid var(--preview-border);
    font-size: clamp(0.42rem, 0.7vw, 0.67rem);
  }

  .guided-preview__nav > div { display: flex; gap: clamp(0.5rem, 2vw, 1.25rem); color: color-mix(in srgb, var(--preview-text) 62%, transparent); }
  .guided-preview__nav-action,
  .guided-preview__actions > span { padding: 0.55rem 0.75rem; color: var(--preview-action-text); background: var(--preview-action); border-radius: min(var(--preview-radius), 0.4rem); }
  .guided-preview__hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(7.5rem, 0.6fr); gap: 8%; padding: 10% 8% 9%; }
  .guided-preview__hero-copy { min-inline-size: 0; }
  .guided-preview__kicker { display: block; font-size: clamp(0.38rem, 0.6vw, 0.58rem); font-weight: 750; letter-spacing: 0.12em; text-transform: uppercase; }
  .guided-preview__heading { max-inline-size: 10ch; margin: 5% 0 3%; font-family: var(--text-heading-family, var(--font-sans)); font-size: clamp(1.7rem, 10cqi, 4.5rem); font-weight: 720; letter-spacing: -0.065em; line-height: 0.92; text-wrap: balance; }
  .guided-preview__lead { max-inline-size: 32rem; margin: 0; color: color-mix(in srgb, var(--preview-text) 68%, transparent); font-size: clamp(0.48rem, 0.85vw, 0.82rem); line-height: 1.5; }
  .guided-preview__lead--expressive strong,
  .guided-preview__lead--expressive span { display: block; font: inherit; }
  .guided-preview__heading--expressive,
  .guided-preview__lead--expressive { display: none; }
  .guided-preview__actions { display: flex; align-items: center; gap: 0.8rem; margin-block-start: 7%; font-size: clamp(0.42rem, 0.72vw, 0.7rem); }
  .guided-preview__hero-note { align-self: end; display: grid; gap: 0.45rem; padding-block-end: 6%; }
  .guided-preview__hero-note span,
  .guided-preview__hero-note small { color: color-mix(in srgb, var(--preview-text) 58%, transparent); font-size: clamp(0.38rem, 0.55vw, 0.55rem); }
  .guided-preview__hero-note strong { font-size: clamp(0.48rem, 0.85vw, 0.8rem); line-height: 1.35; }
  .guided-preview__hero-note i { block-size: 1px; background: var(--preview-border); }
  .guided-preview__artifact { display: none; grid-template-columns: 24% 1fr; grid-template-rows: auto 1fr; min-block-size: clamp(8rem, 18vw, 15rem); overflow: hidden; background: color-mix(in srgb, var(--preview-surface) 91%, var(--preview-text)); border: 1px solid var(--preview-border); border-radius: min(var(--preview-radius), 0.65rem); box-shadow: 0 1rem 2.2rem color-mix(in srgb, var(--preview-text) 14%, transparent); }
  .guided-preview__artifact > header { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.25rem; min-block-size: 1.55rem; padding-inline: 0.55rem; border-block-end: 1px solid var(--preview-border); }
  .guided-preview__artifact > header i { inline-size: 0.28rem; block-size: 0.28rem; background: color-mix(in srgb, var(--preview-text) 35%, transparent); border-radius: 50%; }
  .guided-preview__artifact > header span { margin-inline-start: auto; color: color-mix(in srgb, var(--preview-text) 48%, transparent); font-size: clamp(0.32rem, 0.5vw, 0.48rem); }
  .guided-preview__artifact > aside { display: grid; align-content: start; gap: 0.48rem; padding: 0.7rem 0.45rem; border-inline-end: 1px solid var(--preview-border); }
  .guided-preview__artifact > aside i { block-size: 0.28rem; background: color-mix(in srgb, var(--preview-text) 17%, transparent); border-radius: var(--radius-full); }
  .guided-preview__artifact > aside i:nth-child(2) { inline-size: 72%; }
  .guided-preview__artifact > aside i:nth-child(3) { inline-size: 84%; }
  .guided-preview__artifact > div { display: grid; grid-template-columns: 1fr 0.65fr; align-content: start; gap: 0.55rem; padding: 0.85rem; }
  .guided-preview__artifact > div > * { min-block-size: 0.4rem; background: color-mix(in srgb, var(--preview-text) 12%, transparent); border-radius: 0.15rem; }
  .guided-preview__artifact > div > strong { grid-column: 1 / -1; min-block-size: 2.7rem; background: color-mix(in srgb, var(--preview-action) 17%, var(--preview-surface)); border: 1px solid color-mix(in srgb, var(--preview-action) 30%, var(--preview-border)); }
  .guided-preview__artifact > div > small { grid-column: 1 / -1; min-block-size: 2rem; }
  .guided-preview__proof { display: flex; align-items: center; justify-content: space-around; gap: 1rem; padding: 0.75rem 6%; color: color-mix(in srgb, var(--preview-text) 56%, transparent); background: color-mix(in srgb, var(--preview-surface) 87%, var(--preview-text)); border-block: 1px solid var(--preview-border); font-size: clamp(0.38rem, 0.58vw, 0.58rem); letter-spacing: 0.08em; }
  .guided-preview__proof strong { color: var(--preview-text); }
  .guided-preview__services { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.4rem, 1vw, 0.8rem); padding: 6%; }
  .guided-preview__service { display: flex; flex-direction: column; min-block-size: clamp(6rem, 12vw, 10rem); padding: clamp(0.6rem, 1.4vw, 1.15rem); background: color-mix(in srgb, var(--preview-surface) 92%, var(--preview-text)); border: 1px solid var(--preview-border); border-radius: min(var(--preview-radius), 0.6rem); }
  .guided-preview__service i { color: color-mix(in srgb, var(--preview-text) 54%, transparent); font-size: clamp(0.35rem, 0.5vw, 0.5rem); font-style: normal; }
  .guided-preview__service strong { margin-block-start: auto; font-family: var(--text-heading-family, var(--font-sans)); font-size: clamp(0.62rem, 1.1vw, 1.05rem); }
  .guided-preview__service p,
