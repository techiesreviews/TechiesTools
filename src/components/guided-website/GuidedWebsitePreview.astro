  .guided-preview__service small { margin-block-start: 0.55rem; }
  .guided-preview__feature { display: grid; grid-template-columns: 0.7fr 1.3fr; min-block-size: clamp(7rem, 16vw, 13rem); border-block-start: 1px solid var(--preview-border); }
  .guided-preview__feature > div { display: flex; flex-direction: column; justify-content: flex-end; padding: 10%; }
