---
import AppPage from "../../components/showcase/AppPage.astro";
import { showcaseApps, type ShowcaseApp } from "../../showcase/projects.ts";

export const prerender = true;
export const getStaticPaths = () => showcaseApps.map((app) => ({ params: { app: app.id }, props: { app } }));

const { app } = Astro.props as { app: ShowcaseApp };
---

<AppPage app={app} />
