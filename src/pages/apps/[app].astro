---
import AppPage from "../../components/showcase/AppPage.astro";
import { showcaseApp } from "../../showcase/projects.ts";

const app = showcaseApp(Astro.params.app ?? "");
if (!app) return new Response("Not found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
---

<AppPage app={app} />
